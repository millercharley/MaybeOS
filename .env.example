# ── Required ──────────────────────────────────────────
NODE_ENV="development"
# Always include an explicit connection_limit. Prisma opens a pool PER PROCESS
# (default cpus*2+1), and Supabase's session pooler caps the project at 15
# connections total — so the default exhausts it and every request fails with
# "max clients reached in session mode". See D-018.
#   production (Lambda, many containers): ?connection_limit=1&pool_timeout=20
#   local dev  (one long-lived server):   ?connection_limit=5&pool_timeout=20
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maybeos_dev"
DIRECT_DATABASE_URL=""
JWT_SECRET="change-me-to-a-random-64-char-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"


# ── Sentry (leave empty to skip error tracking) ──────
# Two separate Sentry projects, so an API failure and a browser failure don't
# land in the same issue stream. Empty = the SDK is never initialized.

# API (Node). Set in Netlify env vars; read at runtime.
SENTRY_DSN=""

# Browser + Next.js server. NEXT_PUBLIC_ is INLINED AT BUILD TIME, so setting
# it in Netlify requires a redeploy before it takes effect — editing the
# variable alone changes nothing. A DSN is write-only and safe to expose.
NEXT_PUBLIC_SENTRY_DSN=""

# Optional. Only needed to upload source maps, which turn a minified
# production stack trace into real file/line numbers. Without all three,
# the build skips upload (and skips generating maps) rather than failing.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── App URLs ──────────────────────────────────────────
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Stripe (leave empty to skip payment features) ────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Google Calendar (leave empty to skip) ─────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/oauth/callback"

# ── Email (leave empty = emails logged to console) ────
POSTMARK_API_TOKEN=""
EMAIL_FROM="noreply@maybeos.app"
