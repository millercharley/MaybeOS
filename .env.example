# ── Required ──────────────────────────────────────────
NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maybeos_dev"
DIRECT_DATABASE_URL=""
JWT_SECRET="change-me-to-a-random-64-char-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"


# ── Sentry (leave empty to skip error tracking) ──────
SENTRY_DSN=""

# ── App URLs ──────────────────────────────────────────
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Stripe (leave empty to skip payment features) ────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Google Calendar (leave empty to skip) ─────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/oauth/callback"

# ── Email (leave empty = emails logged to console) ────
POSTMARK_API_TOKEN=""
EMAIL_FROM="noreply@maybeos.app"
