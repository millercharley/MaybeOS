# ── Required ──────────────────────────────────────────
DATABASE_URL="postgresql://maybeos:CHANGE_ME@postgres:5432/maybeos"
DIRECT_DATABASE_URL=""
JWT_SECRET="GENERATE_WITH: openssl rand -base64 48"
POSTGRES_PASSWORD="CHANGE_ME"

# ── App URLs (set to your domain) ────────────────────
WEB_URL="https://app.maybeitsfate.com"
API_URL="https://api.maybeitsfate.com"

# ── Sentry (recommended for production) ─────────────
SENTRY_DSN=""

# ── Stripe (required for payments) ───────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Optional Integrations ────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match a redirect URI registered on the Google OAuth client exactly.
# The API is served from the same host as the app (netlify.toml routes /api/*
# to the function); there is no separate api. subdomain.
GOOGLE_REDIRECT_URI="https://maybeos.org/api/calendar/oauth/callback"
POSTMARK_API_TOKEN=""
EMAIL_FROM="hello@maybeitsfate.com"

# ── Defaults (usually don't need to change) ──────────
JWT_EXPIRES_IN="7d"
POSTGRES_USER="maybeos"
POSTGRES_DB="maybeos"
