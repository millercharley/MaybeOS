generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Migrations and introspection connect straight to Postgres rather than
  /// through the transaction pooler (OPS-11).
  ///
  /// `DATABASE_URL` now points at Supabase's **transaction-mode** pooler, which
  /// is what serverless wants: it multiplexes, so many Lambda containers share
  /// far fewer server connections. Session mode allowed 15 clients in total and
  /// took the API down twice on 2026-08-13 — 502 on every request, login
  /// included — once from several deploys in quick succession and once from a
  /// burst of concurrent requests.
  ///
  /// Transaction mode cannot run migrations: they need a session that holds
  /// state across statements, including advisory locks. Hence this second URL.
  ///
  /// D-007 removed `directUrl` after it broke a Railway deploy when the
  /// variable was unset, and chose session mode to avoid needing it. That
  /// tradeoff is what has now been reversed — with the reason recorded rather
  /// than rediscovered.
  directUrl = env("DIRECT_URL")
}

// ─── Multi-Tenant Foundation ─────────────────────────────────

model Organization {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  mission      String?
  logoUrl      String?
  brandColor   String  @default("#6366f1")
  customDomain String? @unique
  timezone     String  @default("America/New_York")

  /// What an hour of a member's service is worth to this co-op, in cents
  /// (SRV-02). Null, and null by default, which is the honest state.
  ///
  /// Deliberately not defaulted to a national figure. Turning hours into a
  /// dollar "contributed value" is the co-op asserting a rate in a document a
  /// funder will read, and a number MaybeOS invented — however respectable
  /// its source — would be asserted in the co-op's name without anybody
  /// choosing it. Until this is set, ImpactOS reports hours only, which needs
  /// no assumption to be true.
  volunteerHourValueCents Int?

  /// A membership number the co-op is working toward, shown on the member
  /// dashboard beside the real one (Charley, 2026-09-04).
  ///
  /// Null unless an admin sets it, and null by default. A co-op that has not
  /// named a target does not get a progress bar against a number MaybeOS
  /// invented — and "47 members" is a fact, while "47 of 100" is a claim about
  /// what the co-op is for.
  memberGoal Int?

  /// Where members who joined before MaybeOS still manage their billing
  /// (MIG-03). A co-op migrating in brings its members before it brings its
  /// money: those memberships have no MaybeOS subscription and are still
  /// charged by whatever was billing them, and this is the address of that.
  ///
  /// Null for a co-op that started here, which must not be offered a link to
  /// a previous arrangement it never had.
  legacyBillingUrl String?
  /// Whether an event must say which room it is in (SPC-27).
  ///
  /// Off by default, and off is right for most co-ops: plenty of events
  /// happen in a park, a member's front room, or online. A co-op that runs a
  /// building turns it on, and an event then has to name a reservation —
  /// which is what stops the calendar and the room sheet drifting apart.
  requireEventRoom Boolean @default(false)

  /// The longest a member may book a room for, in minutes (SPC-29).
  ///
  /// Three hours by default, which is what most of a co-op's room use looks
  /// like; the ceiling is a day, because a reservation longer than that is
  /// somebody moving in and wants a conversation rather than a form.
  ///
  /// A room may still set its own shorter limit — a darkroom with a queue
  /// knows more about itself than the co-op does — and the shorter of the two
  /// wins.
  maxBookingMinutes Int @default(180)

  /// Whether a member's total room time is capped, and over what (SPC-29).
  ///
  /// Off by default, and off is right for most co-ops: a limit on how much of
  /// the building one member may hold is a thing a co-op decides it needs,
  /// usually after somebody has booked the Attic every Saturday for a year.
  /// Null means no cap at all.
  bookingQuotaPeriod BookingQuotaPeriod?
  /// How many hours of reservations in that period. Null when uncapped.
  bookingQuotaHours  Int?

  /// A wide image across the top of the member dashboard (Charley,
  /// 2026-09-04). Public identity like the logo, and stored in the same public
  /// bucket. Null unless an admin uploads one, and then the dashboard simply
  /// has no banner.
  bannerUrl String?

  /// Whether the co-op shows its members a getting-started checklist in the
  /// sidebar (ONB-01). Off by default — a checklist a co-op has not written is
  /// a nag with nothing behind it.
  onboardingEnabled Boolean @default(false)

  settings             Json    @default("{}")
  // Stripe Billing Portal configuration for this org's members. The portal
  // only offers plan switching when it is given an explicit product list,
  // so each org needs its own configuration naming its own tiers.
  stripePortalConfigId String?
  /// Stripe objects MaybeOS creates on the co-op's own connected account for
  /// dues (PAY-09): `{ accountId, portalConfigId, feeProductId }`. Kept
  /// together with the account id they belong to, so reconnecting a different
  /// account discards them instead of pointing at ids on the old one.
  stripeConnectObjects Json?

  // Off by default: a housing co-op or members' club must not be joinable by
  // anyone with a card. Each org opts in. See D-020.
  allowPublicJoin             Boolean           @default(false)
  /// Whether this co-op tracks shares and ownership at all (MEM-19). Off by
  /// default: most co-ops do not keep an equity register, and one that does
  /// decides when members see it.
  sharesEnabled               Boolean           @default(false)
  /// Whether any member may open a channel in the Commons (CMN-11). Off by
  /// default: a co-op decides for itself whether its Commons is something
  /// members shape or something the organisers do. Channels are open to the
  /// whole co-op either way — see `Channel.isPublic`, which nothing enforces.
  memberChannelsEnabled       Boolean           @default(false)
  /// Whether this co-op issues door codes at all (DOR-01). Off by default:
  /// most co-ops have no door for MaybeOS to let anybody through.
  doorAccessEnabled           Boolean           @default(false)
  /// The Google Sheet the door application reads. MaybeOS owns the codes and
  /// writes this sheet; the sheet is a mirror, not the record — a code edited
  /// there by hand is overwritten on the next sync.
  doorSheetId                 String?
  /// The Apps Script web app that owns the door sheet (DOR-01). MaybeOS
  /// writes members to it with a signed request and never holds access to
  /// the spreadsheet itself. Replaces `doorSheetId`, which is no longer read.
  doorScriptUrl               String?
  /// The shared secret that signs those requests, sealed with secret-box.
  /// Omitted at the Prisma client: it is read by the door sync and nowhere
  /// else.
  doorScriptSecret            Json?
  /// Whether hosts may share this co-op's public events to its Facebook Page
  /// and Instagram account (SOC-01). Off until an admin turns it on.
  socialSharingEnabled        Boolean           @default(false)
  /// Whether a member may share without being switched on individually.
  /// `UserOrg.socialShareAllowed` overrides this for one member either way.
  socialShareMembersByDefault Boolean           @default(true)
  /// Whether members are emailed their code as it is issued (DOR-01). Its own
  /// switch, separate from generating them, so a co-op can fill the sheet and
  /// check it before a few hundred people get a door code in their inbox.
  doorCodeEmailsEnabled       Boolean           @default(false)
  /// Whether MaybeOS welcomes somebody who has just become a member.
  ///
  /// Off by default, and its own switch for the reason every other email
  /// switch is: a co-op moving in from another system usually already has
  /// something sending this — MaybeItsFate had a Zapier automation wired to
  /// Stripe, which welcomed Charley to the *old* system during a test of the
  /// new one — and two welcomes is worse than none. This goes on when that
  /// goes off.
  welcomeEmailEnabled         Boolean           @default(false)
  /// How long an invitation or a sign-in link stays good, in days.
  ///
  /// Seven is right for inviting one person and wrong for inviting a whole
  /// co-op at once: on a wave that size, a week means somebody comes back
  /// from a holiday to a dead link and has to ask for another (MEM-18).
  inviteExpiryDays            Int               @default(7)
  /// The Google calendar whose entries are the co-op's own events (CAL-02).
  ///
  /// Separate from the room calendars, which are reservations: a room being
  /// held is not a thing to attend, and importing every hold as an event
  /// would put "DO NOT BOOK" in front of the whole community. Null until an
  /// admin picks one, and the import simply does not offer events without it.
  eventsCalendarId            String?
  /// Whether Radar is on for this co-op (RDR-01): a weekly digest telling a
  /// member about gatherings open to members that match what they are
  /// interested in. Off until an admin turns it on, and the switch is only
  /// offered on Plus and Unlimited — see `radar-availability.ts`.
  radarEnabled                Boolean           @default(false)
  /// Which day the digest goes out and at what hour, 0 = Sunday, read in the
  /// co-op's own timezone. A co-op knows when its people read email; Thursday
  /// morning is only a starting guess at the weekend ahead.
  radarDigestDay              Int               @default(4)
  radarDigestHour             Int               @default(9)
  /// Whether the monthly recap is on for this co-op (RCP-01): what the month
  /// just ended added up to, drafted on the 1st for an organiser to send.
  /// Plus and Unlimited, like Radar.
  recapEnabled                Boolean           @default(false)
  /// The hour on the 1st when the draft is prepared, in the co-op's own time.
  recapDraftHour              Int               @default(8)
  /// Whether the members' copy carries money (Charley, 2026-10-01). On by
  /// default — a co-op is member-owned and the point of the recap is that
  /// dues paid for something — but a co-op whose finances are organiser
  /// business can turn it off without losing the rest.
  recapShowMoney              Boolean           @default(true)
  /// When dues already charged were read back from Stripe (RCP-01). MaybeOS
  /// recorded no dues payment before that ticket, so without this a co-op's
  /// first recap would report a year of dues as zero. Null means never run.
  duesBackfilledAt            DateTime?
  /// The co-op's MaybeOS plan (D-013). Everyone starts on FREE.
  plan                        MaybeOsPlan       @default(FREE)
  /// The co-op's own Stripe account, from Connect onboarding. Ticket money is
  /// paid here directly and MaybeOS's cut is taken as an application fee —
  /// routing other co-ops' takings through MaybeOS's own account would be
  /// money transmission, not billing (D-013). Null until onboarding completes.
  stripeAccountId             String?
  /// Whether Stripe says the account can actually accept charges. Onboarding
  /// can be started and abandoned halfway, and an account that exists is not
  /// the same as one that can be paid.
  stripeChargesEnabled        Boolean           @default(false)
  /// Which generation of Stripe's Accounts API this account belongs to.
  /// Creating an account uses Accounts v2; linking one the co-op already has
  /// uses Connect OAuth, which always hands back a v1 Standard account because
  /// it predates MaybeOS. A v1 account read through a v2 endpoint fails with
  /// "v1 Accounts cannot be used in v2 Account APIs", and nothing in the id
  /// says which generation it is — so it is recorded when the account is
  /// connected rather than guessed at read time. Null only when none is.
  stripeAccountApi            StripeAccountApi?
  /// The co-op's own subscription to MaybeOS (PLT-02) — not to be confused
  /// with `UserOrg.stripeSubscriptionId`, which is a *member's* dues to their
  /// co-op. Different money, different direction, different Stripe account.
  ///
  /// Matched on when a later subscription event arrives, because a co-op
  /// subscribes through Stripe's hosted pricing table and there is no way to
  /// put our own metadata on what that creates.
  stripePlanCustomerId        String?
  stripePlanSubscriptionId    String?           @unique
  /// Stripe's own word for the subscription — `active`, `past_due`,
  /// `canceled`. Kept verbatim rather than mapped, so a state Stripe adds
  /// later shows up as itself instead of being flattened into a guess.
  planStatus                  String?
  /// A fee the co-op adds to its own ticket sales, on top of MaybeOS's, in
  /// cents per ticket. Charley's requirement: org admins set their own fee in
  /// addition. Zero by default — a co-op that has not chosen one charges none.
  ticketFeeCents              Int               @default(0)
  /// What share of ticket money a member who hosts an event keeps, in basis
  /// points (EVT-15). 10000 is all of it, which is the default — MaybeOS's fee
  /// and the co-op's own fee were both added *on top* of the ticket price and
  /// were never the host's money.
  ///
  /// Basis points rather than a percentage so integer arithmetic does the whole
  /// calculation: a float share lands a fraction of a cent short, and a ledger
  /// that is a cent out is a ledger nobody trusts.
  hostRevenueShareBps         Int               @default(10000)
  /// Suspended by MaybeOS itself (PLT-01). Access stops; nothing is deleted.
  /// What happens to a suspended co-op's *data* is a decision not yet taken,
  /// and this deliberately does not take it — whichever way it goes, nothing
  /// here has to be undone.
  suspendedAt                 DateTime?
  suspendedReason             String?
  /// "MaybeOS for free, except ticket sales" (Charley, 2026-08-19).
  ///
  /// Its own flag rather than a plan, because `plan` does double duty: it sets
  /// what a co-op is billed *and* MaybeOS's cut per ticket. Comping a co-op by
  /// moving it to FREE would triple its members' ticket fees — the opposite of
  /// a gift. A comped co-op is set to the plan it should *have*, pays nothing
  /// for it, and its ticket fee follows that plan as normal.
  billingWaived               Boolean           @default(false)
  billingWaivedReason         String?

  /// MaybeOS's own forum, where every co-op's organisers meet each other
  /// (FRM-01). Exactly one row carries this.
  ///
  /// A real organization rather than a bespoke feature, so it inherits
  /// channels, posts, proposals and moderation for free — a second forum
  /// implementation would be a second thing to secure and a second thing to
  /// forget when the first one changes. What the flag buys is the handful of
  /// places the forum must *not* behave like a co-op: it is never billed,
  /// never listed as a customer in the platform console, and never triggers
  /// its own auto-join.
  isPlatformForum Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations       Location[]
  users           UserOrg[]
  interestTags    InterestTag[]
  duesPayments    DuesPayment[]
  recaps          MonthlyRecap[]
  directMessages  DirectMessage[]
  tiers           MembershipTier[]
  events          Event[]
  rooms           Room[]
  closures        OrgClosure[]
  duties          Duty[]
  onboardingSteps OnboardingStep[]
  links           OrgLink[]
  hostDuties      HostDuty[]
  hostBriefings   HostBriefing[]
  channels        Channel[]
  messageThreads  MessageThread[]
  channelSections ChannelSection[]
  collections     Collection[]
  surveys         Survey[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  emailTemplates  EmailTemplate[]

  expenses                Expense[]
  attachments             Attachment[]
  goals                   Goal[]
  measurementPlan         MeasurementPlan?
  impactReports           ImpactReport[]
  impactReportPurchases   ImpactReportPurchase[]
  belongingSettings       BelongingSettings?
  buddyPairings           BuddyPairing[]
  buddySuggestions        BuddySuggestion[]
  knowledgeArticles       KnowledgeArticle[]
  belongingEmailTemplates BelongingEmailTemplate[]
  hostPayouts             HostPayout[]
  /// The co-op's equity ledger (MEM-17).
  shareGrants             ShareGrant[]
  doorSheetEntries        DoorSheetEntry[]
  socialAccount           OrgSocialAccount?
  eventSocialPosts        EventSocialPost[]

  /// Backs the platform console's org list, which orders by signup date
  /// (PLT-01). Created by that migration but never declared here, so every
  /// subsequent `prisma migrate diff` proposed dropping it — declared now so
  /// the schema and the database agree.
  @@index([createdAt])
  @@map("organizations")
}

model Location {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String   @default("US")
  timezone  String   @default("America/New_York")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rooms  Room[]
  events Event[]

  @@index([orgId])
  @@map("locations")
}

// ─── Users & RBAC ────────────────────────────────────────────

enum GlobalRole {
  PLATFORM_ADMIN
  USER
}

enum OrgRole {
  ADMIN
  STAFF
  MEMBER
  GUEST
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  name            String?
  avatarUrl       String?
  /// Where MaybeOS keeps this avatar itself, in the private `avatars` bucket.
  /// An imported avatar URL points at the platform the co-op is leaving and
  /// dies with that account, so the bytes are copied here on import. A path
  /// wins over `avatarUrl`, which still holds an external URL when that is
  /// all there is.
  avatarPath      String?
  globalRole      GlobalRole @default(USER)
  emailVerified   Boolean    @default(false)
  magicLinkToken  String?
  magicLinkExpiry DateTime?
  lastLoginAt     DateTime?
  /// Set when somebody leaves MaybeOS's forum (FRM-01).
  ///
  /// Leaving deletes the membership row, which leaves no trace — so without
  /// this, founding a second co-op would drag somebody straight back into a
  /// forum they had already left. "We asked once and they said no" has to
  /// outlive the row it was recorded on.
  forumOptOutAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  orgs             UserOrg[]
  rsvps            Rsvp[]
  bookings         Booking[]
  dutyClaims       DutyClaim[]
  dutyAdoptions    DutyAdoption[]
  posts            Post[]
  comments         Comment[]
  reactions        Reaction[]
  channelReads     ChannelRead[]
  threadsStarted   MessageThread[]         @relation("ThreadCreator")
  threadSeats      ThreadParticipant[]
  threadMessages   ThreadMessage[]         @relation("ThreadSender")
  messageReactions ThreadMessageReaction[]
  commentReactions CommentReaction[]
  votes            Vote[]
  surveyResponses  SurveyResponse[]
  sentMessages     DirectMessage[]         @relation("SentMessages")
  receivedMessages DirectMessage[]         @relation("ReceivedMessages")
  collectionPages  CollectionPage[]
  hostedEvents     Event[]                 @relation("HostedEvents")
  createdEvents    Event[]                 @relation("CreatedEvents")
  coHostedEvents   EventCoHost[]
  tickets          Ticket[]

  expensesCreated       Expense[]              @relation("ExpenseCreator")
  plansApproved         MeasurementPlan[]      @relation("PlanApprover")
  reportsCreated        ImpactReport[]         @relation("ReportAuthor")
  impactReportPurchases ImpactReportPurchase[] @relation("ImpactReportPurchaser")
  hostPayouts           HostPayout[]           @relation("HostPayoutRecipient")
  payoutsMarked         HostPayout[]           @relation("HostPayoutPayer")
  attachments           Attachment[]
  /// Share grants naming this member (MEM-19).
  shareGrants           ShareGrant[]
  /// Channels this member opened (CMN-11).
  channelsCreated       Channel[]              @relation("ChannelCreator")

  @@map("users")
}

model UserOrg {
  id                    String             @id @default(uuid())
  userId                String
  orgId                 String
  role                  OrgRole            @default(MEMBER)
  tierId                String?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  /// The Stripe account this member's customer and subscription live on
  /// (PAY-09). Null is MaybeOS's own account (dues before PAY-09); a connected
  /// account id for dues paid to the co-op directly, and for adopted
  /// subscriptions.
  stripeDuesAccountId   String?
  /// The flat MaybeOS fee added on top of this member's dues, in cents (0 when
  /// none). Set when the subscription starts; cleared when the co-op leaves
  /// the Free plan and the fee is taken off the subscription.
  duesFeeCents          Int                @default(0)
  subscriptionStatus    SubscriptionStatus @default(NONE)
  /// Whether this membership is set to end when the paid period does (PLT-06).
  ///
  /// Stripe's portal cancels at period end, so `subscriptionStatus` stays
  /// ACTIVE — correctly, the member paid for the month — and without this the
  /// product cannot tell somebody who is leaving from somebody who is staying.
  cancelAtPeriodEnd     Boolean            @default(false)
  /// When the current paid period runs out, from Stripe. The date shown to a
  /// member who has cancelled, and null for anyone who has never subscribed.
  currentPeriodEnd      DateTime?
  memberSince           DateTime           @default(now())
  bio                   String?
  /// One line under a member's name — what they do, what to ask them about.
  headline              String?
  /// Free text as the member wrote it ("Butchertown, KY"), not a resolved
  /// place. Nothing geocodes it and nothing should assume it parses.
  location              String?
  /// Three-valued on purpose: true opted in, false opted out, null never
  /// asked. A default would either record a refusal nobody made or
  /// manufacture consent, and consent is the one thing a default must not
  /// invent.
  emailOptIn            Boolean?
  /// When this member put the getting-started checklist away (ONB-01). Only
  /// offered once every step is done, so this is "I have finished with it"
  /// rather than "stop bothering me" — but it is per member and permanent,
  /// because a checklist that comes back is a checklist nobody trusts.
  onboardingDismissedAt DateTime?
  /// The five letters this member types at the co-op's door (DOR-01).
  ///
  /// On the membership rather than the account: a code opens *this* co-op's
  /// door, and somebody who belongs to two co-ops has two doors and two
  /// codes. Null until issued.
  ///
  /// Omitted at the Prisma client, like `demographics` above it — `getMember`
  /// and the member list both read `UserOrg` with `include`, which selects
  /// every column, so without that this would be handed to every member of
  /// the co-op the moment the directory loaded. Read back explicitly by the
  /// member's own profile, the organisers' member list, and the sync.
  doorPin               String?
  doorPinIssuedAt       DateTime?
  /// When this member's row was last written to the co-op's sheet, and when
  /// they were last told their code. Both null means the work is outstanding,
  /// which is how the scheduled task finds it.
  doorPinSyncedAt       DateTime?
  doorPinEmailedAt      DateTime?
  /// Whether this member may share events to the co-op's Facebook and
  /// Instagram (SOC-01). Null follows `Organization.socialShareMembersByDefault`;
  /// an admin sets true or false to decide for this member. Stripped from what
  /// other members see.
  socialShareAllowed    Boolean?
  /// The member's Instagram username, without the @, credited on posts they
  /// share. Per membership, like `links`: what someone publishes in one co-op
  /// is not consent to publish it in another.
  instagramHandle       String?
  tags                  String[]           @default([])
  /// Links a member chooses to show on their profile. On the membership, not
  /// the account: what somebody publishes to one co-op is not consent to
  /// publish it in another. Only http and https are accepted — these are
  /// rendered as links on a page other members read.
  links                 String[]           @default([])
  isPublic              Boolean            @default(true)
  /// Member-owned demographic profile (IMP-17, PRD §6.4). Collected once here
  /// and never inside an impact micro-survey. Scoped to the membership rather
  /// than the user: orgs are firewalled (D-020), and what somebody is willing
  /// to tell one co-op is not consent to tell another. Null means never
  /// answered; an absent key means that field was skipped.
  demographics          Json?

  /// The fatigue budget (D-021, PRD §6.2), which that decision calls the
  /// load-bearing constraint of the whole product: one micro-question per
  /// member per 30 days across *all* touchpoints, dismissal widening the gap,
  /// and three dismissals moving a member to an annual check-in only — with
  /// no admin override, deliberately.
  ///
  /// Scoped to the membership rather than the user, for the same reason as
  /// `demographics`: orgs are firewalled, and one co-op's questions must not
  /// spend another's budget.
  lastAskedAt   DateTime?
  askDismissals Int       @default(0)

  /// Whether this member gets the Radar digest (RDR-01). True rather than
  /// null, unlike `emailOptIn`: an admin turning Radar on is the co-op
  /// deciding, and every digest carries a one-click unsubscribe that writes
  /// false here. `emailOptIn: false` silences Radar regardless — a member who
  /// has unsubscribed from the co-op has unsubscribed from this too.
  radarEmails         Boolean   @default(true)
  /// Whether this member gets the monthly recap (RCP-01). Its own switch,
  /// separate from Radar: one is "here is something you might like" and the
  /// other is "here is what your dues did", and a member may well want the
  /// second without the first.
  /// A second address this member also reads (MEM-19).
  ///
  /// A co-op moving in has people billed at one address and signed up to its
  /// forum at another, and the two have been the same person all along. Mail
  /// MaybeOS sends a member goes to both, so a migration does not quietly
  /// pick the wrong one — signing in is the case that matters, because the
  /// link only arrives at the address somebody still reads.
  ///
  /// On the membership rather than the account, like everything else a member
  /// tells one co-op: what somebody gives one is not consent to use it in
  /// another (D-020).
  altEmail            String?
  recapEmails         Boolean   @default(true)
  /// When this member was sent a link to sign in for the first time (MEM-18).
  ///
  /// A marker rather than a preference, like `doorPinEmailedAt`: it is what
  /// makes the migration send resumable and stops a second run reaching the
  /// people the first one already did. Null means never sent.
  signInSentAt        DateTime?
  /// When the last digest went out, so a run that happens twice in an hour
  /// does not send twice. What stops an *event* repeating is `RadarSend`.
  radarLastSentAt     DateTime?
  /// When this member was last shown the interest picker, and how many times
  /// they have waved it away. **Deliberately not the ImpactOS fatigue budget
  /// (D-021).** That budget buys measurement the member gets nothing back
  /// from; this question is the member configuring something for themselves,
  /// and spending the impact budget on it would silence the surveys for a
  /// month to ask somebody which gatherings they like.
  interestsAskedAt    DateTime?
  interestsDismissals Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tier MembershipTier? @relation(fields: [tierId], references: [id])

  interests    MemberInterest[]
  radarSends   RadarSend[]
  duesPayments DuesPayment[]

  // Belonging Support. A membership, not a person: someone in two co-ops has
  // two buddy histories and two sets of acknowledgments.
  buddyStats             MemberBuddyStats?
  buddyPairingsAsNew     BuddyPairing[]             @relation("BuddyPairingNewMember")
  buddyPairingsAsBuddy   BuddyPairing[]             @relation("BuddyPairingBuddy")
  buddyInvitations       BuddyInvitation[]          @relation("BuddyInvitationCandidate")
  buddyFallbackFor       BelongingSettings[]        @relation("BuddyFallbackAdmin")
  suggestionDismissals   BuddySuggestionDismissal[]
  articlesAuthored       KnowledgeArticle[]         @relation("ArticleAuthor")
  articleAcknowledgments ArticleAcknowledgment[]
  articleLikes           ArticleLike[]
  articleComments        ArticleComment[]
  onboardingCompletions  OnboardingCompletion[]

  @@unique([userId, orgId])
  /// Two members of one co-op must never share a door code. Postgres treats
  /// nulls as distinct, so the many memberships with no code yet do not
  /// collide with each other — the constraint only binds once a code exists.
  @@unique([orgId, doorPin])
  @@index([orgId])
  @@index([orgId, role])
  @@map("user_orgs")
}

/// How a getting-started step knows it is done (ONB-01).
///
/// Every kind but CUSTOM is **derived from what the member has actually done**
/// rather than from a box they ticked. That is the whole difference between a
/// checklist and a to-do list: a co-op asking somebody to fill in their
/// profile wants the profile filled in, not a claim that it was. It also means
/// a member who did the thing before the checklist existed arrives with it
/// already complete, which is the honest state.
///
/// CUSTOM is the escape hatch, and it is deliberately the only one a member
/// marks themselves — an admin can point at anything at all, including
/// something outside MaybeOS, and nothing here can verify it.
enum OnboardingStepKind {
  PROFILE
  HANDBOOK
  COMMONS_POST
  EVENT_RSVP
  ROOM_BOOKING
  SERVICE_CLAIM
  CUSTOM
}

/// One line of a co-op's getting-started checklist (ONB-01).
///
/// The words are always the co-op's. `kind` decides only how completion is
/// detected and where "Do it now" points by default — the title, the
/// description and the button label are written by the admin, because a
/// housing co-op and a maker space ask for the same thing in different words.
model OnboardingStep {
  id          String             @id @default(uuid())
  orgId       String
  kind        OnboardingStepKind @default(CUSTOM)
  title       String
  /// Shown only while this is the active step — the accordion keeps everything
  /// else to a single line.
  description String?
  ctaLabel    String             @default("Do it now")
  /// Where the button goes. Null for a built-in kind, which resolves its own
  /// destination from the co-op's slug; required in practice for CUSTOM.
  href        String?
  position    Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  org         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  completions OnboardingCompletion[]

  @@index([orgId, position])
  @@map("onboarding_steps")
}

/// A member ticking off a CUSTOM step (ONB-01).
///
/// Only ever written for CUSTOM steps. The rest are computed on read, so there
/// is no second copy of the truth to drift from the first — and no way for a
/// stored "done" to outlive the thing it claimed.
model OnboardingCompletion {
  id          String   @id @default(uuid())
  stepId      String
  memberId    String
  completedAt DateTime @default(now())

  step   OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  member UserOrg        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([stepId, memberId])
  @@index([memberId])
  @@map("onboarding_completions")
}

/// Somewhere off MaybeOS that a co-op wants its members to be able to reach
/// (NAV-02).
///
/// A co-op's life does not all live in one product: the store is on Shopify,
/// the white paper is a PDF, the app is in the App Store, and the Instagram is
/// where half the community actually talks. Members were expected to find
/// those on their own, or to have been told once.
///
/// Members-only rather than public. It reads like harmless signage, but a
/// co-op will put a shared Drive or a members' Discord in here, and a list of
/// those URLs on a page anybody can load is the sort of leak nobody notices
/// until it matters. A co-op that wants a link public already has a public
/// page to put it on.
model OrgLink {
  id    String @id @default(uuid())
  orgId String
  label String
  /// http and https only, enforced when it is written. These are rendered as
  /// links members click, so `javascript:` here is script execution in
  /// somebody else's session, not a formatting quirk.
  url   String

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, position])
  @@map("org_links")
}

/// Which MaybeOS plan a co-op is on (D-013). Drives the per-transaction fee
/// MaybeOS takes on ticket sales: FREE 55c, PLUS 30c, UNLIMITED 10c.
enum MaybeOsPlan {
  FREE
  PLUS
  UNLIMITED
}

/// See `Organization.stripeAccountApi`. Two ways in, two kinds of account.
enum StripeAccountApi {
  V1
  V2
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  COMP
}

// ─── MemberOS: Tiers & Subscriptions ────────────────────────

model MembershipTier {
  id                   String   @id @default(uuid())
  orgId                String
  name                 String
  description          String?
  priceMonthly         Int      @default(0) // cents
  priceYearly          Int? // cents
  isPayWhatYouCan      Boolean  @default(false)
  minPrice             Int? // cents, for PWYC
  maxMembers           Int? // null = unlimited
  benefits             String[] @default([])
  stripePriceIdMonthly String?
  /// The Stripe account this tier's product and price live on (PAY-09). Null
  /// is MaybeOS's own account, where tiers were created before dues moved to
  /// each co-op's connected account; such a tier gets a new product on the
  /// connected account at its next checkout.
  stripeDuesAccountId  String?
  stripePriceIdYearly  String?
  // Needed for pay-what-you-can: a member-chosen amount is sent as an
  // inline price_data at checkout, which must attach to this tier's
  // existing Product. Without it we'd create a throwaway Product per
  // checkout and every invoice line would read differently.
  stripeProductId      String?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)

  /// The badge on this tier's card, chosen by the admin (MEM-16), or null for
  /// no badge — which is every tier until somebody asks for one.
  ///
  /// One nullable column rather than a boolean and a label: a tier is
  /// highlighted exactly when it has something to say, and the pair would
  /// allow "highlighted, no text", which the badge cannot render. At most one
  /// tier per co-op carries it; the service clears the others.
  highlightLabel String?

  /// What this tier asks of a member in service (SRV-01), as minutes over a
  /// period. Both null means no expectation, which is the default and the
  /// common case — most tiers ask for money and nothing else.
  ///
  /// Minutes rather than hours because a duty is measured in minutes, and an
  /// expectation stored in a coarser unit than the thing measured against it
  /// can only be compared by rounding one of them.
  serviceMinutes Int?
  servicePeriod  ServicePeriod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     UserOrg[]
  invitations Invitation[]

  @@index([orgId])
  @@map("membership_tiers")
}

// ─── EventsOS ────────────────────────────────────────────────

enum EventVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

/// Who a booking or event is suitable for (SPC-22). Asked of the host when a
/// room is booked, and carried onto the event if the booking is published
/// (EVT-17) -- the two answers drifting apart is worse than either.
enum MaturityLevel {
  ALL_AGES
  AGES_13_PLUS
  AGES_18_PLUS
  AGES_21_PLUS
}

/// Over what stretch a member's room hours are counted (SPC-29).
enum BookingQuotaPeriod {
  MONTH
  YEAR
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model Event {
  id                  String          @id @default(uuid())
  orgId               String
  locationId          String?
  roomId              String?
  title               String
  slug                String
  description         String?
  richDescription     String? // HTML content
  imageUrl            String?
  /// Who made the picture, when it came from somewhere that asks to be
  /// credited (EVT-22). Unsplash's API terms require the photographer's name
  /// and a link back, so a product that uses their search has to have
  /// somewhere to put both — an uncredited photo is a licence breach, not a
  /// missing nicety. Null for an upload or a plain URL, where there is
  /// nobody to credit.
  imageCredit         String?
  imageCreditUrl      String?
  startTime           DateTime
  endTime             DateTime
  timezone            String          @default("America/New_York")
  visibility          EventVisibility @default(PUBLIC)
  recurrence          RecurrenceRule  @default(NONE)
  recurrenceEnd       DateTime?
  parentEventId       String? // for recurring event instances
  capacity            Int?
  /// What a ticket costs, in cents. Null means free — the overwhelming
  /// majority of co-op events — and free is not the same as zero-priced: a
  /// free event never touches Stripe at all.
  priceCents          Int?
  /// ISO 4217, lowercase, as Stripe expects it.
  currency            String          @default("usd")
  /// Who is running this event (EVT-04). Set to whoever created it and
  /// changeable afterwards, because an organiser often creates an event on
  /// somebody else's behalf. Nullable: events made before this column existed
  /// have no known host, and guessing one would invent a fact the product
  /// would then act on — the PRD emails this person after their event.
  hostId              String?
  /// Who made it (EVT-32).
  ///
  /// Distinct from the host, which starts as the creator and can be handed
  /// to somebody else. Without this, handing an event over took the creator's
  /// own ability to correct it with them — and an organiser creating an event
  /// on a member's behalf, which is the case `hostId` exists for, would lose
  /// it the moment they set the host.
  createdById         String?
  /// Who ran it, when MaybeOS has no member for them (CAL-03).
  ///
  /// A co-op importing years of its own calendar brings events hosted by
  /// people who have since left. Their name is part of what the event *was* —
  /// "a workshop, hosted by nobody" is worse than no import — so the Google
  /// organiser travels with the event whether or not it matches anybody.
  ///
  /// The address is matched, never shown: it is how a member who rejoins
  /// finds the evenings they ran, on the day they rejoin, the same way an
  /// imported cap-table line finds its holder.
  hostEmail           String?
  hostName            String?
  /// The booking this event was published from (EVT-05), when a member turned
  /// their room booking into something the co-op can see. One event per
  /// booking. The link is what keeps them in step: cancelling or moving the
  /// booking has to reach the event, or the co-op keeps advertising a room
  /// that is no longer held.
  bookingId           String?         @unique
  /// The post that carries this event's discussion (EVT-11). Created the first
  /// time somebody needs it rather than for every event, and unique because
  /// two events sharing a thread would mix two conversations. Chosen over
  /// teaching Comment about events: one comment model, one moderation surface.
  postId              String?         @unique
  /// Overrides the co-op's default host share for this one event (EVT-15).
  /// Null means "whatever the co-op's default is" rather than a copy of it —
  /// copying today's number onto every event would freeze it into next year's.
  hostRevenueShareBps Int?
  waitlistEnabled     Boolean         @default(false)
  /// Whether the host has stopped selling for now (EVT-41).
  ///
  /// Separate from unpublishing, which hides the event, and from cancelling,
  /// which refunds everybody. A host pauses to hold the last few places back,
  /// to sort out a venue question, or because they are not sure they can take
  /// any more — and the event stays visible, with the people already coming
  /// still coming.
  ticketSalesPaused   Boolean         @default(false)
  requiresRsvp        Boolean         @default(true)
  category            String?
  /// What kind of gathering, in the co-op's own words. Inherited from the
  /// booking when an event is published from one (EVT-17), which is where they
  /// are asked. `category` is the older singular field the admin form writes;
  /// readers prefer these and fall back to it.
  tags                String[]        @default([])
  /// What the host suggests, in cents, for an event paid at the door (EVT-34).
  ///
  /// Optional even when `hasCost` is set: plenty of events ask for something
  /// without naming a figure, and "pay what you can" with a number beside it
  /// is a different offer from "pay what you can". Not a price — nothing
  /// stops anybody coming who does not pay it, and MaybeOS never collects it.
  suggestedCents      Int?
  /// Whether the host charges attendees — cash at the door, Venmo, whatever.
  /// Distinct from `priceCents`, which is a ticket sold through MaybeOS: an
  /// event can have a cost and no ticket, and most co-op events that charge
  /// do exactly that.
  hasCost             Boolean         @default(false)
  /// Who it is suitable for (SPC-22) -- from the booking when published from
  /// one, and editable here. Only the restricting answers are ever displayed.
  maturityLevel       MaturityLevel   @default(ALL_AGES)
  /// The Google calendar entry this came from (CAL-02), where it was
  /// imported rather than created here. What makes a re-run update an event
  /// instead of adding a second copy of it — the same job `googleEventId`
  /// does for a booking.
  googleEventId       String?
  isPublished         Boolean         @default(false)
  publishedAt         DateTime?
  canceledAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: a host leaving the co-op must not delete the events
  // they ran, along with every RSVP and attendance record attached to them.
  host      User?         @relation("HostedEvents", fields: [hostId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: SetNull)
  coHosts   EventCoHost[]

  /// SetNull, not Cascade: an event whose discussion was moderated away should
  /// still exist.
  post        Post?        @relation("EventThread", fields: [postId], references: [id], onDelete: SetNull)
  payout      HostPayout?
  // SetNull rather than Cascade: if a booking row is ever hard-deleted the
  // event it produced should survive as an event, not vanish along with its
  // RSVPs. Cancellation is handled in the service, not by the database.
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// Every room this event occupies (SPC-26). The replacement for `bookingId`,
  /// which could only name one.
  rooms       Booking[]    @relation("EventRooms")
  location    Location?    @relation(fields: [locationId], references: [id])
  room        Room?        @relation(fields: [roomId], references: [id])
  parent      Event?       @relation("EventRecurrence", fields: [parentEventId], references: [id])
  children    Event[]      @relation("EventRecurrence")
  rsvps       Rsvp[]
  radarSends  RadarSend[]
  attendance  Attendance[]
  tickets     Ticket[]
  attachments Attachment[]

  socialPosts EventSocialPost[]

  @@unique([orgId, slug])
  @@unique([orgId, googleEventId])
  @@index([orgId, startTime])
  @@index([orgId, visibility, isPublished])
  /// Finding the events somebody ran, the day they (re)join (CAL-03).
  @@index([orgId, hostEmail])
  @@map("events")
}

enum RsvpStatus {
  CONFIRMED
  WAITLISTED
  CANCELED
  TENTATIVE
}

model Rsvp {
  id          String     @id @default(uuid())
  eventId     String
  userId      String? // null for guest RSVPs
  guestName   String?
  guestEmail  String?
  status      RsvpStatus @default(CONFIRMED)
  plusOnes    Int        @default(0)
  note        String?
  checkedIn   Boolean    @default(false)
  checkedInAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("rsvps")
}

/// A paid ticket to an event.
///
/// Written only when Stripe confirms the payment, never when checkout starts —
/// an abandoned checkout must not hold a seat, and a row created hopefully at
/// session creation is a row somebody has to clean up.
model Ticket {
  id                    String    @id @default(uuid())
  eventId               String
  /// Null for a guest buying without an account, which is most of the public.
  userId                String?
  buyerEmail            String
  buyerName             String?
  /// What the buyer actually paid, all in. The three amounts below are how it
  /// was split, recorded at purchase rather than recomputed later — plans and
  /// fees change, and a receipt from March must still add up in December.
  amountCents           Int
  /// MaybeOS's cut (D-013), by the co-op's plan at the time of sale.
  platformFeeCents      Int
  /// The co-op's own additional fee, if it set one.
  orgFeeCents           Int
  currency              String    @default("usd")
  stripeSessionId       String    @unique
  stripePaymentIntentId String?
  refundedAt            DateTime?
  createdAt             DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@map("tickets")
}

model Attendance {
  id         String   @id @default(uuid())
  eventId    String
  userId     String?
  guestEmail String?
  /// What the door wrote down for someone with no account. A check-in desk
  /// realistically gets a name or nothing; demanding an address to record
  /// that a person was present would lose the count entirely (IMP-10).
  guestName  String?
  method     String   @default("manual") // manual, qr, self
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("attendance")
}

// ─── SpaceOS: Rooms & Bookings ───────────────────────────────

model Room {
  id                 String    @id @default(uuid())
  orgId              String
  locationId         String?
  name               String
  description        String?
  capacity           Int?
  amenities          String[]  @default([])
  /// A photo of the room, stored privately and served as a signed URL like
  /// every other member-facing image (BEL-10). Named `imagePath` rather than
  /// `imageUrl` because it holds a storage key — the previous name is what led
  /// to article covers being published publicly the first time.
  imagePath          String?
  /// Which part of the photo the square and circular crops show (SPC-19), as
  /// a percentage across its width — the number CSS `object-position` takes,
  /// so 50 is what the browser already did. Same pattern as a Handbook
  /// cover's `coverFocusX`, applied where the problem was first noticed.
  imageFocusX        Int       @default(50)
  isActive           Boolean   @default(true)
  requiresApproval   Boolean   @default(false)
  memberOnly         Boolean   @default(true)
  /// Whether this room charges for hire (SPC-06). Off by default — Charley,
  /// 2026-08-13: rooms have no booking fee unless an admin activates one.
  /// Separate from `hourlyRate` so that turning charging off does not throw
  /// away the rate, and so a half-filled form cannot start billing people.
  chargeForBooking   Boolean   @default(false)
  /// Bookable at any hour, said deliberately rather than inferred from having
  /// no availability rules. Those two used to be the same state, so a room
  /// whose opening hours nobody had set yet was silently published around the
  /// clock. Unchecked with no rules now means not bookable.
  alwaysAvailable    Boolean   @default(false)
  hourlyRate         Int? // cents per hour, null = not set
  /// Longest single booking a member can make, in minutes. Null means no cap.
  /// Drives which duration choices the booking screen offers, so a room that
  /// cannot be held for three hours never shows the option (SPC-09).
  maxBookingMinutes  Int?
  /// Which calendar on the connected account this room writes to. 'primary'
  /// is a poor default for a co-op: the organiser who connects is usually
  /// signed in as themselves, so bookings for the Attic would land in their
  /// personal calendar and their dentist appointment would block the room.
  /// Null means connected but not yet pointed at a calendar (SPC-07).
  googleCalendarId   String?
  /// The calendar's display name, kept so the rooms page can say which one is
  /// connected without calling Google on every render.
  googleCalendarName String?
  /// Which Google account authorised this, shown to the admin. An organiser
  /// who connects the wrong account otherwise has no way to tell.
  googleAccountEmail String?
  googleConnectedAt  DateTime?
  /// The room's Google OAuth tokens, **sealed** (SEC-15): AES-256-GCM, stored
  /// as `{ v, iv, tag, ct }` rather than as the token object. Opened only by
  /// `CalendarService`, which is also the only thing that opts back in to
  /// reading the column at all — the Prisma client omits it everywhere else.
  ///
  /// This comment used to read "encrypted OAuth tokens" while the code stored
  /// plain JSON. It is the reason the gap survived a month: a comment that
  /// states an intention as a fact stops the next reader looking.
  googleTokens       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id])
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  hostDuties        HostDuty[]
  events            Event[]

  @@index([orgId])
  @@map("rooms")
}

/// When the whole building is shut (SPC-13).
///
/// Separate from `AvailabilityRule` rather than a row with a null roomId: a
/// room-level rule and a building-level one answer different questions, and
/// making roomId optional would let every query that forgets to filter treat a
/// building closure as belonging to whichever room it joined against.
///
/// These never make a room bookable. They only subtract, so a room with no
/// opening hours of its own stays unbookable regardless.
model OrgClosure {
  id            String   @id @default(uuid())
  orgId         String
  /// Why the building is shut. Shown to members on the booking screen.
  label         String?
  /// "00:00"-"23:59" for a whole day; a narrower window closes part of it.
  startTime     String   @default("00:00")
  endTime       String   @default("23:59")
  effectiveFrom DateTime
  effectiveTo   DateTime
  createdAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("org_closures")
}

model AvailabilityRule {
  id            String    @id @default(uuid())
  roomId        String
  dayOfWeek     Int? // 0=Sunday..6=Saturday; null = all days
  startTime     String // "09:00" (HH:mm)
  endTime       String // "17:00" (HH:mm)
  bufferMinutes Int       @default(0)
  isBlackout    Boolean   @default(false) // true = blocked
  /// Why the room is shut, for closures (SPC-12). Shown to members on the
  /// booking screen: "Closed: Winter break" is worth far more than a greyed
  /// out row, and a member who does not know why cannot tell a mistake from a
  /// holiday.
  label         String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("availability_rules")
}

enum BookingStatus {
  /// Held while the member is in Stripe Checkout (SPC-06). A room slot is
  /// exclusive, so unlike a ticket it cannot be sold twice and sorted out
  /// later — the hold is what stops two people paying for the same hour.
  /// Swept by the scheduler if the checkout is abandoned.
  PENDING_PAYMENT
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model Booking {
  id             String  @id @default(uuid())
  roomId         String
  userId         String
  /// Who reserved the room, when it was not a member MaybeOS knows (CAL-03).
  ///
  /// `userId` is required, so an imported reservation by somebody who has
  /// since left used to be filed under the co-op's first organiser — a
  /// booking history that quietly says one person held every room for years.
  /// These two say whose it actually was, and are cleared when the real
  /// member turns up.
  bookedForEmail String?
  bookedForName  String?
  /// The event this reservation is for (SPC-26).
  ///
  /// An event can occupy more than one room — a gig using the Attic and the
  /// Salon is two reservations and one evening — so the link lives here
  /// rather than on the event. `Event.bookingId` held the opposite shape,
  /// one booking per event, and could not say that.
  ///
  /// Null for an ordinary reservation: most of a co-op's room use is a
  /// rehearsal or a meeting, not something the whole community is invited to.
  eventId        String?
  /// A hold the co-op made, not a booking a member made (SPC-23).
  ///
  /// An imported room reservation created by the account the co-op's
  /// automation runs on belongs to the co-op: it blocks the room, organisers
  /// see it, and it is in nobody's My Bookings. MaybeItsFate's import filed
  /// 3,017 of them under one person, which is how this was found.
  isCoopHold     Boolean @default(false)
  title          String
  description    String?

  /// What the booking is for, asked when it is made (SPC-15).
  ///
  /// A room booking used to carry a title and nothing else, and the title the
  /// form sent was the room's own name — so the co-op's Google Calendar read
  /// "Attic" against a three-hour block and told an organiser walking past
  /// nothing at all about who was in there or why.
  ///
  /// Who it is open to. Reuses EventVisibility rather than a second enum
  /// saying the same three things, since a booking published as an event
  /// (EVT-05) has to answer this question anyway.
  visibility         EventVisibility @default(PRIVATE)
  /// Roughly how many people. A guess, and asked as one.
  expectedAttendance Int?
  /// Whether attendees are charged by the member — not by the co-op, which is
  /// `priceCents` below and a different question entirely.
  hasCost            Boolean         @default(false)
  /// What kind of gathering: "Art or expression", "Organising", "Social".
  categories         String[]        @default([])
  /// Who it is suitable for (SPC-22). All ages unless the host says
  /// otherwise: the choice the form preselects, and what every booking made
  /// before the question existed is taken to be.
  maturityLevel      MaturityLevel   @default(ALL_AGES)
  startTime          DateTime
  endTime            DateTime
  status             BookingStatus   @default(PENDING)
  googleEventId      String? // synced calendar event ID
  reviewedBy         String?
  reviewedAt         DateTime?
  canceledAt         DateTime?

  /// Hire charges (SPC-06). Null throughout on a free room, which is the
  /// default and the common case for a co-op.
  ///
  /// Recorded at booking rather than recomputed from the room later: an
  /// admin who changes the hourly rate in June must not change what somebody
  /// was charged in March.
  priceCents            Int?
  /// MaybeOS's cut (D-013), by the co-op's plan at the time of booking.
  platformFeeCents      Int?
  /// What the member actually paid, all in.
  amountCents           Int?
  currency              String    @default("usd")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  refundedAt            DateTime?
  /// When an unpaid hold stops blocking the slot. Null once paid.
  holdExpiresAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room           Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting an event must not release the room
  /// silently — the co-op still held it, and somebody has to decide.
  event          Event?               @relation("EventRooms", fields: [eventId], references: [id], onDelete: SetNull)
  user           User                 @relation(fields: [userId], references: [id])
  /// The event published *from* this booking (EVT-05), the other side of
  /// `Event.bookingId`. Superseded by `event` above, which is the link that
  /// can describe an evening using two rooms (SPC-26); kept while the older
  /// one still has readers.
  publishedEvent Event?
  briefings      HostBriefingNotice[]

  @@index([roomId, startTime, endTime])
  @@index([userId])
  /// Finding the reservations somebody made, the day they (re)join (CAL-03).
  @@index([bookedForEmail])
  /// The rooms one event occupies (SPC-26).
  @@index([eventId])
  /// Somebody's own bookings, without the co-op's holds (SPC-23).
  @@index([userId, isCoopHold])
  @@map("bookings")
}

// ─── CommonsOS: Social & Governance ──────────────────────────

model Channel {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  slug        String
  description String?
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  isPinned    Boolean  @default(false)
  /// A single emoji shown before the name, the way Circle marks a channel
  /// (CMN-11). Null is normal and renders a plain `#`.
  emoji       String?
  /// The named group this channel files under (CMN-11), or null for the
  /// ungrouped list at the top. `onDelete: SetNull` — deleting a section is
  /// filing, not deleting conversations.
  sectionId   String?
  /// Who opened it (CMN-11). Null for every channel that predates this and
  /// for anything seeded. Kept so a member can rename the channel they
  /// started without being an admin.
  createdById String?
  /// The order an admin put the channels in (CMN-10).
  ///
  /// Zero for every channel that existed before this, which is deliberate: a
  /// co-op that has never reordered anything keeps the order it had, because
  /// the list falls back to creation date within a position.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  section   ChannelSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  posts     Post[]
  proposals Proposal[]
  reads     ChannelRead[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([orgId, position])
  @@index([sectionId])
  @@map("channels")
}

/// A conversation between two or more members (CMN-16).
///
/// Charley: "the user can type in one or more members, select that member or
/// members... This can be a group message thread or an individual DM thread."
///
/// `direct_messages` could not answer that. It held a sender and a receiver,
/// so a conversation was a pair and a third person had nowhere to go. A
/// one-to-one is now a thread with two participants — the same object, the
/// same screen, the same unread count — and the only difference between a DM
/// and a group is how many people are in it.
///
/// The old table is migrated into this one and left in place, dormant. It is
/// not read any more; keeping it costs nothing and dropping a table to tidy
/// up is how a mistake becomes unrecoverable.
model MessageThread {
  id          String  @id @default(uuid())
  orgId       String
  /// Who started it. Null for anything migrated.
  createdById String?
  /// A name, for a group that has earned one. Null is normal and renders as
  /// the participants' names.
  title       String?

  /// Every participant's id, sorted and joined.
  ///
  /// This is what makes "message these three again" land in the thread that
  /// already exists rather than opening a second one beside it — the bug
  /// every chat product has had at least once. Sorted, so the same people in
  /// a different order are the same conversation.
  participantKey String

  /// When somebody last said something, for ordering the list. Not
  /// `updatedAt`: marking a thread read must not raise it to the top.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("ThreadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ThreadParticipant[]
  messages     ThreadMessage[]

  /// One thread per set of people per co-op. The tenant is in the key
  /// because two people who share two co-ops hold two conversations (CMN-08).
  @@unique([orgId, participantKey])
  @@index([orgId, lastMessageAt])
  @@map("message_threads")
}

/// Somebody in a conversation, and how far they have read it.
model ThreadParticipant {
  id         String    @id @default(uuid())
  threadId   String
  userId     String
  /// Null until they open it, which means everything in it is unread.
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  /// The badge's query: every thread this person is in.
  @@index([userId])
  @@map("thread_participants")
}

/// One thing somebody said.
model ThreadMessage {
  id       String @id @default(uuid())
  threadId String
  senderId String
  body     String

  createdAt DateTime @default(now())

  thread    MessageThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User                    @relation("ThreadSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions ThreadMessageReaction[]

  @@index([threadId, createdAt])
  @@map("thread_messages")
}

/// How far a member has read in a channel (CMN-14).
///
/// The Commons had no read state of any kind — no membership, no last-read, no
/// per-post marker — so nothing in the product could say what was new. This is
/// the smallest thing that can: one row per member per channel, holding the
/// moment they last looked.
///
/// Shaped after `Reaction`, which was the only per-user-per-object row the
/// Commons already had. Deliberately NOT a membership: a row appearing here
/// grants nothing and its absence denies nothing — every member can still see
/// every channel. It only records reading.
///
/// A member with no row for a channel is read up to the day they joined, not
/// to the beginning of time. Otherwise MaybeItsFate's 426 imported members
/// would each have opened the app to a badge counting the co-op's entire
/// history, which is a number nobody acts on.
model ChannelRead {
  id         String   @id @default(uuid())
  userId     String
  channelId  String
  /// When they last had the channel open. Advanced on every visit.
  lastReadAt DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@map("channel_reads")
}

/// A named group of channels — Circle's "General", with channels filed under
/// it (CMN-11). The co-op's own information architecture, so an admin makes
/// them; a channel with no section simply sits above the first one.
model ChannelSection {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@unique([orgId, name])
  @@index([orgId, position])
  @@map("channel_sections")
}

model Post {
  id        String   @id @default(uuid())
  channelId String
  authorId  String
  title     String?
  body      String
  isPinned  Boolean  @default(false)
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  attachments Attachment[]
  eventThread Event?       @relation("EventThread")

  @@index([channelId, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the author last rewrote this, or null if they never have (CMN-09).
  ///
  /// Deliberately not `updatedAt`, which moves for any write at all — flagging
  /// a comment for moderation would mark it "edited" and quietly accuse
  /// somebody of changing their words. This is set only by the author's own
  /// edit, so the marker the thread shows is true.
  editedAt DateTime?

  post        Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id])
  parent      Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]         @relation("CommentReplies")
  attachments Attachment[]
  reactions   CommentReaction[]

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

// ─── CommonsOS: Collections (wiki) ───────────────────────────

model Collection {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  emoji       String   @default("📄")
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pages CollectionPage[]

  @@index([orgId])
  @@map("collections")
}

model CollectionPage {
  id           String   @id @default(uuid())
  collectionId String
  authorId     String
  title        String
  body         String // HTML content
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  @@index([collectionId])
  @@map("collection_pages")
}

model Reaction {
  id     String @id @default(uuid())
  postId String
  userId String
  emoji  String // e.g. "thumbsup", "heart"

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId, emoji])
  @@map("reactions")
}

/// An emoji somebody left on a message in a conversation (CMN-17).
///
/// Charley: "Make sure people can leave an emoji reaction on any message."
/// Posts in the Commons already had this; messages did not, and neither did
/// comments — so "any" meant two new tables rather than one.
///
/// Its own table rather than a nullable column on `reactions`: a polymorphic
/// parent cannot carry a foreign key, and without one a deleted message
/// leaves its reactions behind forever. Three small tables that each delete
/// with their parent beat one clever one that does not.
model ThreadMessageReaction {
  id        String @id @default(uuid())
  messageId String
  userId    String
  emoji     String

  message ThreadMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One of each emoji per person per message. Pressing again removes it.
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("thread_message_reactions")
}

/// The same, on a reply in the Commons (CMN-17).
model CommentReaction {
  id        String @id @default(uuid())
  commentId String
  userId    String
  emoji     String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("comment_reactions")
}

/// A message between two members *of one organization* (CMN-08).
///
/// `orgId` is the tenant boundary, not a convenience. Without it a message
/// had a sender and a receiver and nothing else, so the `orgs/:orgId` on the
/// DM routes was decorative: any authenticated user could message any user in
/// the system by id. CMN-07 patched that at the boundary by requiring the
/// other party to belong to the org in the URL, but the data itself still had
/// no tenant — two people who shared two co-ops shared one thread across both,
/// and a conversation could not be retained, exported or deleted per-org.
///
/// Charley's decision, 2026-08-12: orgs are firewalled. A member of one co-op
/// must not see or message a member of another, and two people who happen to
/// share two co-ops hold two separate conversations, one in each.
model DirectMessage {
  id         String    @id @default(uuid())
  orgId      String
  senderId   String
  receiverId String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sender   User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver User         @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([orgId, senderId, receiverId])
  @@index([orgId])
  /// The badge's query: "how many has this person not read yet" (CMN-14).
  /// Without it that count is a sequential scan of every message in the co-op,
  /// run by every signed-in member every minute.
  @@index([receiverId, readAt])
  @@map("direct_messages")
}

// ── Governance

enum ProposalStatus {
  DRAFT
  OPEN
  CLOSED
  PASSED
  FAILED
}

model Proposal {
  id        String         @id @default(uuid())
  channelId String
  authorId  String
  title     String
  body      String
  status    ProposalStatus @default(DRAFT)
  quorum    Int? // minimum votes needed
  closesAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@index([channelId])
  @@map("proposals")
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

model Vote {
  id         String     @id @default(uuid())
  proposalId String
  userId     String
  choice     VoteChoice
  createdAt  DateTime   @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
  @@map("votes")
}

// ─── ImpactOS: Surveys & Metrics ─────────────────────────────

enum SurveyType {
  BASELINE
  FOLLOWUP
  CUSTOM
}

/// The canonical question types. Previously these were free-form strings in a
/// JSON blob, and the writer and the reader disagreed about them (IMP-04).
enum SurveyQuestionType {
  SCALE // 1-5
  NUMBER
  CHOICE
  TEXT
}

model Survey {
  id          String     @id @default(uuid())
  orgId       String
  title       String
  description String?
  type        SurveyType @default(CUSTOM)
  isActive    Boolean    @default(false)
  publishedAt DateTime?
  closesAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]
  windows   CollectionWindow[]
  responses SurveyResponse[]

  @@index([orgId])
  @@map("surveys")
}

/// A single question, as a row rather than an entry in a JSON blob.
///
/// `questions Json` is what produced IMP-04 and IMP-05. Question types were
/// free-form strings, so the seed wrote "likert" while the renderer switched on
/// "SCALE" and no member could answer anything; and answers were keyed by
/// question id while the aggregation averaged keys named after categories, so
/// no metric could ever be non-null. Neither mistake is expressible now: the
/// type is an enum the database enforces, and an answer points at a question
/// row instead of naming a string.
///
/// Questions are versioned and never edited in place. Changing wording retires
/// the current version and writes a new one, so a figure can always be traced
/// to the exact text a member was shown — the "visible seam" the PRD requires
/// of any mid-collection wording change (D-021).
/// Where a micro-question is asked (PRD §6.2, D-021). The four P0 moments
/// that already exist in MaybeOS, so a question costs a member no extra trip.
enum Touchpoint {
  TICKET_PURCHASE
  BOOKING
  POST_EVENT
  COMMONS
}

model SurveyQuestion {
  id             String             @id @default(uuid())
  surveyId       String
  key            String // stable identity across versions, e.g. "belonging_frequency"
  version        Int                @default(1)
  text           String
  type           SurveyQuestionType
  options        String[]           @default([]) // CHOICE only
  /// The two ends of a SCALE, in the member's language ("never" … "always").
  /// A 1–5 with no anchors is five buttons rather than a question, and the
  /// answers only mean anything if everybody read the ends the same way.
  anchorLow      String?
  anchorHigh     String?
  /// Which direction is good news. Belonging and loneliness are both 1–5 and
  /// point opposite ways, so a report averaging a category without this would
  /// print "loneliness 4.2" beside "belonging 4.2" and read them alike.
  higherIsBetter Boolean            @default(true)
  category       String? // the indicator this feeds, e.g. "belonging"
  /// The moment this question is attached to (IMP-15). Null means it belongs
  /// to a survey answered in one sitting rather than to a touchpoint.
  touchpoint     Touchpoint?
  required       Boolean            @default(false)
  sortOrder      Int                @default(0)
  retiredAt      DateTime? // set when a newer version supersedes this one
  createdAt      DateTime           @default(now())

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([surveyId, key, version])
  @@index([surveyId])
  @@map("survey_questions")
}

/// The period a set of responses belongs to.
///
/// G5 in the PRD: every figure in a report traces to a response count *and* a
/// collection window. Without a window, "average belonging: 3.8" is a number
/// with no denominator and no dates, which is exactly the kind of claim a
/// funder discounts. It is also the unit that makes deduplication meaningful —
/// one response per member per window, not one per member forever.
model CollectionWindow {
  id        String    @id @default(uuid())
  surveyId  String
  label     String // e.g. "2026 baseline"
  opensAt   DateTime  @default(now())
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@unique([surveyId, label])
  @@index([surveyId])
  @@map("collection_windows")
}

model SurveyResponse {
  id           String   @id @default(uuid())
  surveyId     String
  windowId     String
  userId       String? // null for anonymous responses
  demographics Json? // consent-based, collected separately from answers
  createdAt    DateTime @default(now())

  survey  Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  window  CollectionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id])
  answers SurveyAnswer[]

  /// IMP-08: one response per member per window. Postgres treats NULLs as
  /// distinct, so anonymous responses are not collapsed by this — which is
  /// correct, since there is no identity to deduplicate them by.
  @@unique([windowId, userId])
  @@index([surveyId])
  @@map("survey_responses")
}

/// One answer to one version of one question, stored in a typed column.
///
/// `category` is copied from the question at write time. That is safe rather
/// than drift-prone because question versions are immutable, and it lets the
/// dashboard aggregate with a groupBy instead of loading every response into
/// memory and matching strings — which is what the old implementation did, on
/// keys nothing ever wrote.
/// What a co-op spent, at the smallest size that makes the PRD's composites
/// computable (IMP-16, amending D-021).
///
/// D-021's non-goals list **bookkeeping**, and that stands: this is not an
/// accounting system and must not grow into one. There are deliberately no
/// vendors, no invoices, no payment status, no reconciliation, no attachments,
/// no approval workflow and no double entry. A co-op's books live in its
/// accounting software; this records only enough for "what did that outcome
/// cost" and "how much of our spend served our goals" to have a denominator.
///
/// If a field here ever needs a second table to make sense, that is the signal
/// this has outgrown its decision and should be reconsidered rather than
/// extended.
/// A thing the co-op is trying to do, in its own words (IMP-21, PRD §5).
///
/// Three to five, written plainly. The mission they serve lives on
/// `Organization.mission`; this is what the co-op said it would do about it.
///
/// Everything MaybeOS collected before this existed had nothing to attach to:
/// it could report a belonging score and never say why that co-op cared about
/// belonging. A goal is what turns a figure into a finding.
model Goal {
  id          String    @id @default(uuid())
  orgId       String
  title       String
  description String?
  sortOrder   Int       @default(0)
  /// Archived rather than deleted: a goal a co-op pursued for a year is part
  /// of what its report says, and removing it would rewrite the past.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  indicators Indicator[]
  expenses   Expense[]

  @@index([orgId])
  @@map("goals")
}

/// What measures a goal.
///
/// `category` is the same string the questions and the aggregation already
/// use, which is the point: a goal inherits figures that are already being
/// collected rather than needing a parallel collection of its own. This is
/// what the survey-builder non-goal (D-021) buys — measurement is chosen from
/// what exists, not invented per co-op.
model Indicator {
  id        String   @id @default(uuid())
  goalId    String
  category  String
  label     String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  /// The same category measuring one goal twice would double-count it in
  /// every figure drawn from that goal.
  @@unique([goalId, category])
  @@map("indicators")
}

enum MeasurementPlanStatus {
  DRAFT
  APPROVED
}

/// Whether the goals and indicators as they now stand have been agreed to.
///
/// Separate from the goals themselves because approval is a fact about a
/// moment, not about a row: editing a goal after approval returns the plan to
/// draft, since **a plan that changes after it was approved is not an
/// approved plan**. The PRD has an admin approve a measurement plan before
/// anything is asked against it, and an approval that silently survives its
/// own contents changing would be a signature on a blank page.
model MeasurementPlan {
  id           String                @id @default(uuid())
  orgId        String                @unique
  status       MeasurementPlanStatus @default(DRAFT)
  approvedAt   DateTime?
  /// Nulled rather than cascaded: an organiser leaving must not erase the
  /// record of who approved what the co-op measures.
  approvedById String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvedBy User?        @relation("PlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("measurement_plans")
}

/// Which of the two reports this is.
///
/// The PRD's promise is that a co-op states a goal and gets a report back, so
/// BASIC — the deterministic reading assembled from frozen figures — stays
/// free forever. WRITTEN is the same figures with prose composed around them,
/// and is what the $50 buys (D-031). Splitting them here rather than with a
/// boolean leaves room for a third kind without a migration that rewrites
/// every row's meaning.
/// How the written report's prose is getting on (IMP-23).
///
/// The written report is the free report with better sentences over the same
/// frozen figures, so it is readable from the moment it exists and this only
/// says whether the rewriting has happened. FAILED is a real, survivable
/// state: the co-op keeps the deterministic text, which is flat and true.
enum ComposeStatus {
  NOT_NEEDED
  PENDING
  COMPOSING
  READY
  FAILED
}

enum ReportTier {
  BASIC
  WRITTEN
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

/// The year-end report — what ImpactOS exists to produce (IMP-22, PRD §7).
///
/// The only part of the module a co-op ever shows anyone: a grant panel, a
/// board, a members' meeting. Everything else is machinery for making this
/// truthful.
///
/// **Frozen at generation, never recomputed.** A report published in January
/// that quietly reads differently in March is the worst thing this feature
/// could do — the number a funder was sent has to stay the number they see.
/// So the figures are written into the blocks when the report is made, and
/// regenerating produces a *new* reading rather than editing history.
model ImpactReport {
  id            String        @id @default(uuid())
  orgId         String
  title         String
  slug          String
  /// The period the figures describe, not the period they were written in.
  periodStart   DateTime
  periodEnd     DateTime
  status        ReportStatus  @default(DRAFT)
  tier          ReportTier    @default(BASIC)
  composeStatus ComposeStatus @default(NOT_NEEDED)
  /// Why the last composition gave up, for the admin and for us.
  composeNote   String?
  composedAt    DateTime?
  publishedAt   DateTime?
  generatedAt   DateTime
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("ReportAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  blocks    ReportBlock[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("impact_reports")
}

/// One part of a report.
///
/// Blocks rather than one body of prose, so an admin edits the paragraph they
/// disagree with instead of rewriting the whole thing — and so "how much of
/// this did a human change" is a number the product can see rather than a
/// claim it makes.
model ReportBlock {
  id            String   @id @default(uuid())
  reportId      String
  sortOrder     Int      @default(0)
  kind          String
  heading       String?
  /// What is shown. Starts equal to `generatedBody`.
  body          String?
  /// What MaybeOS wrote, kept beside the edited version so a co-op can see
  /// what it changed.
  generatedBody String?
  isEdited      Boolean  @default(false)
  /// The figures this block rests on, frozen: category, average, respondents,
  /// window label and dates. G5 — every figure traces to a response count and
  /// a collection window — is kept true by carrying them, not by promising.
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report ImpactReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, sortOrder])
  @@map("report_blocks")
}

enum ImpactReportPurchaseStatus {
  PENDING
  PAID
  REFUNDED
}

/// A co-op's $50 purchase of the written year-end report (IMP-23, D-031).
///
/// **The purchase is of a reporting period, not of a document.** A co-op that
/// pays for 2026 can regenerate, revise and republish its 2026 written report
/// as often as it likes; charging per generation would make a co-op ration the
/// revisions that make the report honest. Coverage is containment, not an
/// exact date match — an admin who nudges the end date by a day has not bought
/// a new period, and being generous here costs less than a support ticket.
///
/// Recorded from the webhook, never the success redirect: a co-op that closes
/// the tab has still paid.
model ImpactReportPurchase {
  id          String                     @id @default(uuid())
  orgId       String
  /// The period the purchase entitles, copied from the report the admin was
  /// looking at when they bought. Frozen — moving it would silently re-scope
  /// what was paid for.
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  status      ImpactReportPurchaseStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  /// Who bought it. Nullable so removing an admin never deletes the co-op's
  /// entitlement along with them.
  purchasedById String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchasedBy User?        @relation("ImpactReportPurchaser", fields: [purchasedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([orgId, periodStart, periodEnd])
  @@map("impact_report_purchases")
}

enum HostPayoutStatus {
  PENDING
  PAID
  CANCELLED
}

/// What a member who hosted an event is owed, and whether they got it
/// (EVT-15).
///
/// Ticket money lands in the **co-op's** Stripe account — D-013 uses direct
/// charges precisely so MaybeOS never holds anybody's takings — so a member
/// host is owed money their co-op is holding. MaybeOS works out what that is
/// from the tickets actually sold and records that it was paid; the co-op
/// sends it the way it already pays people.
///
/// Charley's call, 2026-08-21: **track now, Stripe later.** Automating the
/// transfer would make MaybeOS an orchestrator of money between two parties
/// whose funds it does not hold, and would put every host through Stripe
/// identity verification before they could be paid for a $60 workshop. So
/// `stripeTransferId` sits here empty and ready rather than unbuilt: when that
/// decision is taken, a transfer attaches to a row that already exists.
model HostPayout {
  id               String           @id @default(uuid())
  orgId            String
  eventId          String           @unique
  hostUserId       String?
  /// Ticket face value only — the fees were added on top of the ticket price
  /// and belong to MaybeOS and the co-op, not the host.
  grossCents       Int
  shareBps         Int
  amountCents      Int
  ticketCount      Int              @default(0)
  refundedCount    Int              @default(0)
  status           HostPayoutStatus @default(PENDING)
  paidAt           DateTime?
  paidById         String?
  /// How it was actually sent, in the organiser's words. MaybeOS did not move
  /// this money and should not pretend to know how it moved.
  note             String?
  stripeTransferId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// SetNull on both: somebody leaving the co-op must not erase the record
  /// that money was owed and paid.
  host   User?        @relation("HostPayoutRecipient", fields: [hostUserId], references: [id], onDelete: SetNull)
  paidBy User?        @relation("HostPayoutPayer", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([hostUserId])
  @@map("host_payouts")
}

model Expense {
  id          String   @id @default(uuid())
  orgId       String
  /// Integer cents, like every other amount in MaybeOS. Money in floats is how
  /// a ledger stops adding up.
  amountCents Int
  /// The day the money went out, which is not the day it was recorded.
  incurredOn  DateTime
  /// A co-op's own word for the kind of spend — "Programs", "Space", "Staff".
  /// Free text rather than an enum: a co-op naming its own categories is the
  /// point, and an enum would need a migration every time one is added.
  category    String
  /// Which goal this spend served, if any — now the foreign key its own
  /// comment promised it would become once goals were modelled (IMP-21).
  /// Null stays normal and honest: not all spend serves a stated goal, and
  /// pretending otherwise is what makes an alignment figure meaningless.
  goalId      String?
  description String?
  /// Who recorded it. Kept for the audit trail, nulled rather than cascading
  /// so an admin leaving does not delete the co-op's financial history.
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator User?        @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  /// SetNull: deleting a goal must not delete the record of money spent.
  goal    Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([orgId, incurredOn])
  @@index([orgId, goalId])
  @@map("expenses")
}

model SurveyAnswer {
  id           String  @id @default(uuid())
  responseId   String
  questionId   String
  category     String?
  numericValue Float? // SCALE and NUMBER
  textValue    String? // TEXT
  choiceValue  String? // CHOICE

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@index([category])
  @@map("survey_answers")
}

// ─── Platform: Webhook Idempotency ──────────────────────────

model WebhookEvent {
  id          String   @id
  source      String   @default("stripe")
  processedAt DateTime @default(now())

  @@index([source, processedAt])
  @@map("webhook_events")
}

// ─── Platform: Audit & Email ─────────────────────────────────

model Invitation {
  id         String    @id @default(uuid())
  orgId      String
  email      String
  role       OrgRole   @default(MEMBER)
  /// The tier this person is being invited onto (MEM-04), if any.
  ///
  /// Accepting an invitation used to create a membership with no tier and no
  /// dues, so an invited member joined for free while somebody arriving
  /// through the public page paid — the same co-op, two prices, depending on
  /// how you got in. Null stays valid and means exactly what it says: joining
  /// without dues, which is right for staff and for co-ops that do not charge.
  tierId     String?
  token      String    @unique @default(uuid())
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull rather than Cascade: deleting a tier must not silently delete
  /// the invitations that referenced it, leaving people with dead links.
  tier MembershipTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  actorId    String?
  action     String // e.g. "member.joined", "event.published"
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, action])
  @@map("audit_logs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  orgId     String
  slug      String // e.g. "welcome", "renewal-reminder"
  subject   String
  bodyHtml  String
  bodyText  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@map("email_templates")
}

/// A file a member attached to a post, a comment or an event.
///
/// The bytes live in the private `attachments` bucket in the same Supabase
/// project as this database, so a file and the row referencing it can never
/// drift into different accounts. Exactly one owner column is set, enforced by
/// a check constraint — an attachment belonging to two things at once, or to
/// nothing, is not a state anything downstream should have to reason about.
model Attachment {
  id         String   @id @default(uuid())
  orgId      String
  uploaderId String
  postId     String?
  commentId  String?
  eventId    String?
  /// Object key inside the bucket, always `<orgId>/<uuid>.<ext>`.
  path       String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  post     Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  event    Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([postId])
  @@index([commentId])
  @@index([eventId])
  @@map("attachments")
}

// ── Belonging Support (BEL-01 … BEL-08)
//
// Two tools that share one idea: a new member should not have to work out on
// their own who to talk to or what this place expects of them. The Buddy
// System gives them a named human within days; the Knowledge Center gives the
// co-op somewhere durable to say what it stands for, and a way to know people
// have read it.
//
// **A "member" here is a `UserOrg`, not a `User`.** Someone in two co-ops has
// two memberships, two buddy histories, and two sets of acknowledgments —
// having served as a buddy in one co-op is not a reason to skip you in
// another, and agreeing to one co-op's norms says nothing about the other's.

/// Per-org configuration for both tools (PRD §4).
///
/// A row rather than keys in `Organization.settings`, because the scheduler
/// filters on these every fifteen minutes and a JSON blob cannot be indexed
/// or type-checked. Defaults live here so a co-op that has never opened the
/// settings page still has coherent behaviour — and both tools default OFF,
/// so enabling MaybeOS never silently starts emailing a co-op's members.
model BelongingSettings {
  id    String @id @default(uuid())
  orgId String @unique

  buddySystemEnabled      Boolean @default(false)
  buddyInviteTimeoutHours Int     @default(48)
  buddyAskCooldownDays    Int     @default(30)
  buddyServeCooldownDays  Int     @default(90)
  buddyMaxActivePairings  Int     @default(1)
  /// The membership a pairing falls back to when the pool is exhausted.
  /// Null means "whichever admin has been here longest", resolved at use.
  buddyFallbackAdminId    String?

  knowledgeCenterEnabled   Boolean @default(false)
  requiredReadingGraceDays Int     @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fallbackAdmin UserOrg?     @relation("BuddyFallbackAdmin", fields: [buddyFallbackAdminId], references: [id], onDelete: SetNull)

  @@map("belonging_settings")
}

enum BuddyPairingState {
  SEEKING
  ACTIVE
  NEEDS_ADMIN
  CLOSED
}

/// One new member's search for a buddy, and its outcome (PRD §5.1).
model BuddyPairing {
  id            String            @id @default(uuid())
  orgId         String
  newMemberId   String
  buddyMemberId String?
  state         BuddyPairingState @default(SEEKING)
  /// Set when an admin closes or reassigns, so the log can say who and why.
  closedById    String?
  closeReason   String?
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime          @updatedAt

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  newMember   UserOrg           @relation("BuddyPairingNewMember", fields: [newMemberId], references: [id], onDelete: Cascade)
  buddyMember UserOrg?          @relation("BuddyPairingBuddy", fields: [buddyMemberId], references: [id], onDelete: SetNull)
  invitations BuddyInvitation[]

  @@index([orgId, state])
  @@index([newMemberId])
  @@map("buddy_pairings")
}

enum BuddyInvitationState {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

/// One ask, answered or not (PRD §5.2: "every ask writes to the log whether
/// or not it is answered — this is what makes rotation real").
///
/// The token is **stored hashed**. It is emailed and works without a login,
/// so a database read must not yield a working accept link. The plaintext
/// exists once, in the moment the email is built, and never again.
model BuddyInvitation {
  id               String               @id @default(uuid())
  pairingId        String
  candidateId      String
  tokenHash        String               @unique
  state            BuddyInvitationState @default(PENDING)
  sentAt           DateTime             @default(now())
  expiresAt        DateTime
  respondedAt      DateTime?
  /// Whether the Off the Hook email has gone out, so a retried scheduler run
  /// cannot send it twice.
  offTheHookSentAt DateTime?

  pairing   BuddyPairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  candidate UserOrg      @relation("BuddyInvitationCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([pairingId, state])
  @@index([state, expiresAt])
  @@index([candidateId])
  @@map("buddy_invitations")
}

/// Rotation state, kept as counters rather than derived from the invitation
/// log every time (PRD §5.2 sorts the whole eligible pool by these on every
/// ask, and a co-op with a long history should not pay for its own past).
///
/// Written in the same transaction as the invitation that changes them, so
/// the counters and the log cannot disagree.
model MemberBuddyStats {
  id           String    @id @default(uuid())
  memberId     String    @unique
  timesAsked   Int       @default(0)
  timesServed  Int       @default(0)
  lastAskedAt  DateTime?
  lastServedAt DateTime?
  /// The member's own choice, from their profile. Never set by an admin.
  optedOut     Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  member UserOrg @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_buddy_stats")
}

/// Admin-authored prompts a buddy sees in the DM thread (PRD §5.4).
///
/// The new member never sees these. A buddy being coached is fine; a new
/// member watching their welcome be scripted is not.
model BuddySuggestion {
  id        String   @id @default(uuid())
  orgId     String
  body      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dismissals BuddySuggestionDismissal[]

  @@index([orgId, position])
  @@map("buddy_suggestions")
}

model BuddySuggestionDismissal {
  id           String   @id @default(uuid())
  suggestionId String
  memberId     String
  dismissedAt  DateTime @default(now())

  suggestion BuddySuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  member     UserOrg         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, memberId])
  @@map("buddy_suggestion_dismissals")
}

enum ArticleState {
  DRAFT
  PUBLISHED
}

/// One Knowledge Center article (PRD §6.1).
model KnowledgeArticle {
  id                     String       @id @default(uuid())
  orgId                  String
  title                  String
  slug                   String
  /// A path in the **private** attachments bucket, signed on read.
  ///
  /// It was briefly a public URL, on the reasoning that cover art is org-level
  /// content rather than member PII. The reference screenshots settled it the
  /// other way: an article cover is typically a photograph of that co-op's
  /// members in their own space, and a Knowledge Center article is
  /// members-only — so a permanent public URL would be a photo of a co-op's
  /// members reachable by anyone who ever got the link.
  coverImagePath         String?
  /// Which part of the banner the square thumbnail shows (BEL-12), as a
  /// percentage across its width — the same number CSS `object-position`
  /// takes, so the default of 50 is exactly what the browser would have done
  /// on its own.
  ///
  /// Only X: a 3:1 banner in a 1:1 frame uses the full height, so there is no
  /// vertical choice to make.
  coverFocusX            Int          @default(50)
  body                   String
  authorId               String?
  position               Int          @default(0)
  state                  ArticleState @default(DRAFT)
  requiresAcknowledgment Boolean      @default(false)
  /// Bumped only by a *material* edit. An acknowledgment is of a version, so
  /// a typo fix must not silently invalidate everyone's agreement — and a
  /// change of meaning must not silently keep it.
  version                Int          @default(1)
  publishedAt            DateTime?
  /// When the current version started requiring acknowledgment. The grace
  /// period counts from here, not from `publishedAt`, so a v2 gets its own.
  requiredSince          DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author          UserOrg?                @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  acknowledgments ArticleAcknowledgment[]
  likes           ArticleLike[]
  comments        ArticleComment[]

  @@unique([orgId, slug])
  @@index([orgId, position])
  @@map("knowledge_articles")
}

/// "I have read and understand this", recorded against a version (PRD §6.2).
///
/// An explicit checkbox and button, never scroll depth. What is stored is
/// what a co-op would need if the agreement were ever disputed: who, which
/// version, when, and from where.
model ArticleAcknowledgment {
  id             String   @id @default(uuid())
  articleId      String
  articleVersion Int
  memberId       String
  acknowledgedAt DateTime @default(now())
  ip             String?

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  member  UserOrg          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([articleId, articleVersion, memberId])
  @@index([memberId])
  @@map("article_acknowledgments")
}

model ArticleLike {
  id        String   @id @default(uuid())
  articleId String
  memberId  String
  createdAt DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  member  UserOrg          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([articleId, memberId])
  @@map("article_likes")
}

model ArticleComment {
  id        String   @id @default(uuid())
  articleId String
  memberId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  member  UserOrg          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@map("article_comments")
}

enum BelongingEmailKind {
  /// The welcome a new member gets (MEM-17). Here rather than in a table of
  /// its own: this is already the place a co-op writes its own words for an
  /// email MaybeOS sends, and a second template system is how one of them
  /// ends up weaker than the other.
  WELCOME
  /// Asking somebody who is not a member yet to join (MEM-18).
  INVITE
  /// Telling somebody who is *already* a member how to sign in — the email a
  /// co-op moving in sends its whole roster (MEM-18). Its own kind rather
  /// than a reworded invitation, because the two say opposite things: one
  /// asks you to join, the other tells you nothing has changed.
  SIGN_IN
  BUDDY_INVITATION
  OFF_THE_HOOK
  INTRO_TO_BUDDY
  INTRO_TO_NEW_MEMBER
  REQUIRED_READING
}

/// An admin's own words for one of the module's emails (PRD §5.3).
///
/// Absent means "use the shipped default", so a co-op that never edits
/// anything still sends sensible mail, and editing is a real override rather
/// than a copy of the default that silently stops tracking improvements to it.
model BelongingEmailTemplate {
  id        String             @id @default(uuid())
  orgId     String
  kind      BelongingEmailKind
  subject   String
  body      String
  updatedAt DateTime           @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind])
  @@map("belonging_email_templates")
}

/// How often a tier's service expectation resets (SRV-01).
///
/// Calendar windows, not anniversaries: every member is measured over the
/// same week, month or year, which is what makes "who is short" a list an
/// organiser can read across the co-op rather than a set of private
/// stopwatches. A member's first window is prorated from the day they joined.
enum ServicePeriod {
  WEEK
  MONTH
  YEAR
}

enum DutyClaimStatus {
  /// Volunteered, waiting on an organiser. Only reachable on a gated duty.
  CLAIMED
  /// Theirs to do.
  CONFIRMED
  /// Done, and the minutes counted.
  DONE
  /// The moment passed and nobody marked it done.
  MISSED
  /// Handed back before the day. Kept rather than deleted so a duty that is
  /// claimed and dropped repeatedly is visible as such.
  RELEASED
}

/// Something the co-op needs doing (SRV-01).
///
/// A definition, not a pile of dated rows. "Trash, Tuesdays, 30 minutes" is
/// one record and its occurrences are computed from the rule, the way room
/// slots already are — so there is no horizon to keep topped up, and moving
/// the duty to Wednesdays does not leave a year of stale Tuesdays behind. A
/// row in `duty_claims` exists only where somebody actually took a turn.
model Duty {
  id          String  @id @default(uuid())
  orgId       String
  title       String
  description String?

  /// What one turn takes, as the organiser's estimate. This is what gets
  /// credited when a member marks it done, and what they can correct.
  estimatedMinutes Int     @default(30)
  /// How many people one occurrence needs. Two to shift the tables.
  capacity         Int     @default(1)
  /// Whether an organiser has to say yes before it is theirs — for the
  /// duties that need training, keys, or trust.
  requiresApproval Boolean @default(false)

  recurrence RecurrenceRule @default(NONE)
  /// The first occurrence, as the instant that local date begins. Dates are
  /// stored as instants and read back through the co-op's timezone, the same
  /// way closures are (SPC-12).
  startsOn   DateTime
  /// The last, or null for as long as the co-op needs it doing.
  endsOn     DateTime?
  /// "HH:MM" in the co-op's own timezone, like a room's opening hours. Not an
  /// instant: "Tuesdays at 9" has to stay 9 across a daylight saving change.
  startTime  String         @default("09:00")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  claims    DutyClaim[]
  adoptions DutyAdoption[]

  @@index([orgId, isActive])
  @@map("duties")
}

/// One member, one turn (SRV-01).
model DutyClaim {
  id       String          @id @default(uuid())
  dutyId   String
  userId   String
  /// Which occurrence this is: the instant that turn starts.
  occursAt DateTime
  status   DutyClaimStatus @default(CONFIRMED)

  /// Minutes credited, once done. Null until then.
  minutes       Int?
  /// Set when the member changed the number, so an organiser can tell a
  /// correction from an estimate that was simply accepted.
  minutesEdited Boolean @default(false)
  /// Why it differed.
  minutesNote   String?

  /// When the morning reminder went out (SRV-04).
  ///
  /// Marked before the email is sent, not after: `EmailService` swallows its
  /// own failures, so a null here after a send would mean the next run sends
  /// it again — and a reminder arriving twice is worse than one that did not
  /// arrive, because it is the one somebody stops reading.
  remindedAt  DateTime?
  completedAt DateTime?
  releasedAt  DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  /// Set when this turn came from adopting the series rather than from one
  /// deliberate click, so releasing the adoption knows what to give back.
  adoptionId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  duty     Duty          @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  adoption DutyAdoption? @relation(fields: [adoptionId], references: [id], onDelete: SetNull)

  /// A member takes a given turn once. Two rows would count the hours twice.
  @@unique([dutyId, userId, occursAt])
  @@index([dutyId, occursAt])
  @@index([userId, status])
  /// Whose turn is today and has not been reminded (SRV-04).
  @@index([remindedAt, occursAt])
  @@map("duty_claims")
}

/// "I'll take all of these" (SRV-01).
///
/// Standing rather than a bulk claim of the occurrences that happen to exist
/// today: somebody who adopts the trash owns it until they hand it back, and
/// that has to include the Tuesdays nobody has computed yet. It materialises
/// claims ahead of itself so the duty still appears on the calendar with a
/// name against it — a standing arrangement that shows up nowhere is exactly
/// how a co-op discovers in March that nobody has done it since December.
model DutyAdoption {
  id         String    @id @default(uuid())
  dutyId     String
  userId     String
  startedAt  DateTime  @default(now())
  /// When an organiser last checked this arrangement still suits the person
  /// holding it (SRV-04). Null means never — the flag then counts from
  /// `startedAt`, so a duty adopted eight months ago is already overdue.
  ///
  /// Stored rather than derived from age alone, because a badge that cannot be
  /// cleared is one nobody reads: reviewing clears it, and it returns six
  /// months later.
  reviewedAt DateTime?
  /// Null while it stands.
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  duty   Duty        @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])
  claims DutyClaim[]

  @@index([dutyId, releasedAt])
  @@index([userId])
  @@map("duty_adoptions")
}

/// Where in a booking a host duty falls (SRV-03).
enum HostDutyPhase {
  BEFORE
  DURING
  AFTER
}

/// When a briefing goes out, relative to the booking it is about.
///
/// Two kinds, because the two defaults Charley asked for are two different
/// things: "7am on the day" is a clock time, and "an hour before it ends" is
/// an offset. Collapsing them into one would mean expressing 7am as "minutes
/// before start", which changes meaning with every booking.
enum BriefingAnchor {
  /// At `clockTime` on the booking's own day, in the co-op's timezone.
  CLOCK_ON_DAY
  BEFORE_START
  AFTER_START
  BEFORE_END
  AFTER_END
}

/// Something a host has to do around their booking (SRV-03).
///
/// Not a `Duty`: nobody claims these and nobody volunteers for them. They come
/// with the room, they are always the host's, and they recur because bookings
/// do rather than because a rule says so. The two models share a word and
/// nothing else.
model HostDuty {
  id        String        @id @default(uuid())
  orgId     String
  /// Null applies to every room. Set scopes it to one — the Attic's lockup is
  /// not the Studio's.
  roomId    String?
  phase     HostDutyPhase
  text      String
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room Room?        @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([orgId, phase, isActive])
  @@map("host_duties")
}

/// The message a host is sent for one phase, and when (SRV-03).
///
/// One row per phase per co-op, and **no rows until an admin writes them**.
/// A co-op does not start emailing its members because MaybeOS shipped a
/// feature; the absence of a row is how the feature stays off.
model HostBriefing {
  id            String         @id @default(uuid())
  orgId         String
  phase         HostDutyPhase
  subject       String
  /// The admin's own words. The duties for this phase are listed underneath.
  body          String
  anchor        BriefingAnchor @default(CLOCK_ON_DAY)
  /// "HH:MM" in the co-op's timezone. Read only for CLOCK_ON_DAY.
  clockTime     String         @default("07:00")
  /// Minutes. Read for every anchor except CLOCK_ON_DAY.
  offsetMinutes Int            @default(60)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, phase])
  @@map("host_briefings")
}

/// What has already been sent, so a re-run cannot send it twice (SRV-03).
///
/// The scheduler has no jobs table by design (D-022): each task asks the
/// database what is overdue and acts. That makes a record of what went out the
/// only thing standing between a retried invocation and a member getting the
/// same email four times.
model HostBriefingNotice {
  id        String        @id @default(uuid())
  bookingId String
  phase     HostDutyPhase
  sentAt    DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, phase])
  @@map("host_briefing_notices")
}

/// What a line in the equity ledger records (MEM-17): the cap table's own
/// columns, plus an adjustment for a row whose total disagrees with its parts.
enum ShareGrantKind {
  ANNUAL
  FOUNDER
  BELIEVER
  BOUNTY
  REFERRAL
  ADJUSTMENT
}

/// Where a ledger line came from (MEM-19). A re-import of the cap table
/// replaces IMPORT lines only, so a grant made in MaybeOS is never wiped by it.
enum ShareGrantSource {
  IMPORT
  MANUAL
}

/// One line in a co-op's equity ledger (MEM-17, MEM-19).
///
/// A holder's balance is the sum of their lines, the way a real cap table
/// works: transactions first, balances derived, so every number shown can be
/// traced to where it came from — and corrected by an adjustment, never by
/// editing history.
///
/// Belongs to a member by `userId` when it names one (every grant made in
/// MaybeOS, and every imported line whose email matched a member), otherwise
/// by `holderEmail` — the cap table predates most members' accounts, and a line
/// has to find its member the day they join. The email is matched on the
/// server and never returned; it is omitted at the Prisma client.
model ShareGrant {
  id          String           @id @default(uuid())
  orgId       String
  /// The member it belongs to. Null for a cap-table holder not yet in MaybeOS.
  userId      String?
  holderEmail String
  /// As the source wrote it. Shown to organisers only.
  holderName  String?
  kind        ShareGrantKind
  /// Signed: an ADJUSTMENT is negative when a balance is corrected downward.
  shares      Int
  source      ShareGrantSource @default(IMPORT)
  /// Why, in the admin's words. Optional.
  note        String?
  /// The admin who recorded a MaybeOS grant. Null on imported lines.
  grantedById String?
  /// Which import wrote it. Null on a grant made in MaybeOS.
  importBatch String?
  /// When the line was recorded — imported or granted.
  importedAt  DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, holderEmail])
  @@index([orgId, userId])
  @@map("share_grants")
}

/// Somebody else running an event alongside the host (EVT-32).
///
/// A co-op's events are rarely one person's: a workshop has somebody teaching
/// and somebody on the door, a gig has the act and whoever is letting them in.
/// `hostId` could only ever name one of them, so the other had no way to
/// correct a time, see who was coming, or be written to about their own event.
///
/// A row rather than a column, because the list is open-ended and because
/// `addedById` is worth keeping: handing somebody responsibility for an event
/// is a decision, and it is useful to know whose.
model EventCoHost {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  /// The organiser or host who added them. Null if that account is gone.
  addedById String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One person cannot co-host the same event twice.
  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_co_hosts")
}

/// What MaybeOS last wrote to a co-op's door sheet, one row per email (DOR-01).
///
/// Kept separately from the membership because a membership can disappear:
/// someone removed from the co-op, or an account deleted, takes their
/// `user_orgs` row with them, and without this record nothing would remember
/// that their code is still in the sheet. The sync compares what should be
/// there with this, marks anyone who is gone as revoked, and sends only what
/// changed.
model DoorSheetEntry {
  id       String   @id @default(uuid())
  orgId    String
  /// Lowercased. The sheet matches on email, so this does too.
  email    String
  doorPin  String
  name     String
  revoked  Boolean
  syncedAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("door_sheet_entries")
}

/// The Facebook Page and Instagram account a co-op shares events to (SOC-01).
///
/// Connected once by an admin through Facebook Login. The Page token is
/// sealed with secret-box and omitted at the Prisma client. `pendingPages`
/// holds the choices, sealed, for the few minutes between Facebook sending the
/// admin back and the admin picking one, when their login manages several
/// Pages.
model OrgSocialAccount {
  id            String    @id @default(uuid())
  orgId         String    @unique
  pageId        String?
  pageName      String?
  pageToken     Json?
  igUserId      String?
  igUsername    String?
  pendingPages  Json?
  pendingUntil  DateTime?
  connectedById String?
  connectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_social_accounts")
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

/// One event shared to one platform (SOC-01). Unique per event and platform,
/// so a double click or a second host cannot post the same event twice.
///
/// Written as PENDING before the post goes out, which is what takes the
/// unique slot, and set to PUBLISHED with the post's link after. A failed post
/// deletes its row so it can be tried again.
model EventSocialPost {
  id         String         @id @default(uuid())
  orgId      String
  eventId    String
  platform   SocialPlatform
  status     String         @default("PENDING")
  externalId String?
  permalink  String?
  postedById String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, platform])
  @@index([orgId, createdAt])
  @@map("event_social_posts")
}

/// ---------------------------------------------------------------------------
/// Radar (RDR-01): matching what a member is interested in to the gatherings
/// their co-op is actually running.
/// ---------------------------------------------------------------------------

/// One interest in a co-op's own list — the words its members pick from and
/// its hosts tag gatherings with.
///
/// Seeded from a MaybeOS starter set so a co-op is never shown an empty box,
/// and editable from there: renaming one rewrites the name wherever it is
/// already written on an event, so a rename is a rename rather than a
/// quiet un-tagging. The six gathering kinds that EVT-20 hard-coded in the
/// web form are part of the starter set, which is what keeps every event
/// tagged before Radar existed meaningful afterwards.
///
/// Deactivated rather than deleted where it is in use: a tag nobody can
/// choose any more still has to explain the events that already carry it.
model InterestTag {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  /// Shown beside the name in the picker. Optional, and never load-bearing.
  emoji     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members MemberInterest[]

  @@unique([orgId, name])
  @@index([orgId, isActive, sortOrder])
  @@map("interest_tags")
}

/// What one member is interested in, and how MaybeOS came to think so.
///
/// `declared` is the member's own answer and is three-valued on purpose:
/// true is "yes, this interests me", false is "no, stop suggesting it", and
/// null means they have never been asked. `rsvpCount` is what MaybeOS
/// inferred from the gatherings they actually went to. **A declared false
/// always wins** — an inference is a guess about somebody, and a member who
/// has said no is not guessing.
///
/// Every row is visible to the member it describes and editable by them, and
/// no view shows one member another's interests.
model MemberInterest {
  id         String    @id @default(uuid())
  userOrgId  String
  tagId      String
  declared   Boolean?
  rsvpCount  Int       @default(0)
  /// The most recent RSVP that counted toward `rsvpCount`, so an interest a
  /// member has not acted on in two years can be aged out later without
  /// having to re-read every RSVP they ever made.
  lastRsvpAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  membership UserOrg     @relation(fields: [userOrgId], references: [id], onDelete: Cascade)
  tag        InterestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userOrgId, tagId])
  @@index([userOrgId])
  @@map("member_interests")
}

/// An event Radar has already told a member about.
///
/// This is the idempotency key for the digest, and the reason it is a row
/// rather than a timestamp: "have we mentioned this one?" is a question about
/// a pair, and a scheduler that runs every fifteen minutes will ask it again.
/// Written before the email is handed to Postmark, because `EmailService`
/// swallows failures — the same bargain `doorPinEmailedAt` makes, and the
/// safer direction to fail in: a gathering mentioned once and missed beats one
/// mentioned every quarter of an hour.
model RadarSend {
  id        String   @id @default(uuid())
  userOrgId String
  eventId   String
  sentAt    DateTime @default(now())

  membership UserOrg @relation(fields: [userOrgId], references: [id], onDelete: Cascade)
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userOrgId, eventId])
  @@index([userOrgId, sentAt])
  @@map("radar_sends")
}

/// ---------------------------------------------------------------------------
/// The monthly recap (RCP-01): what the month just ended added up to.
/// ---------------------------------------------------------------------------

/// One dues payment that actually cleared.
///
/// **MaybeOS recorded none of this before RCP-01**, which is the whole reason
/// this table exists. `invoice.paid` was not a handled event: a member's dues
/// went through, Stripe knew, and MaybeOS's database learned nothing — so the
/// one figure that makes "your membership sustains this" true was the one
/// figure the product could not state. Subscription *status* was stored all
/// along, and a status is not a payment.
///
/// Written from the webhook going forward and backfilled once from Stripe for
/// the months already gone. `stripeInvoiceId` is unique, so a redelivered
/// event and the backfill cannot both count the same money.
///
/// Amounts are the co-op's, in the co-op's currency: `amountCents` is what the
/// member paid and `feeCents` what MaybeOS took of it (PAY-09's application
/// fee, zero on Plus and Unlimited). Stripe's own processing fee is not here —
/// MaybeOS never sees it on a direct charge, and guessing it would turn a
/// recorded figure into an estimate.
model DuesPayment {
  id              String    @id @default(uuid())
  orgId           String
  /// The membership it was for, where MaybeOS can tell. Null for a payment on
  /// a subscription it no longer recognises — somebody who has since left, or
  /// one adopted before MaybeOS saw it. The money was still real.
  userOrgId       String?
  stripeInvoiceId String    @unique
  /// Which Stripe account took it. Dues moved to each co-op's own account in
  /// PAY-09, and a co-op mid-move has payments on both.
  stripeAccountId String?
  amountCents     Int
  feeCents        Int       @default(0)
  currency        String    @default("usd")
  paidAt          DateTime
  /// Set when the payment was later refunded, so a recap that has already
  /// gone out can be read against a figure that changed afterwards.
  refundedAt      DateTime?
  /// Who paid, copied onto the payment rather than looked up through
  /// `userOrgId` (PAY-10). That relation is `SetNull`, so removing a member
  /// detaches their payments and the co-op keeps the money with nobody
  /// attached to it. A payment is a historical fact; a fact that depends on a
  /// row somebody can delete is not one you can rely on afterwards.
  ///
  /// PII. Never returned to a member or an organiser — the ledger and the
  /// member card show no addresses (D-020) — and only here so that a receipt
  /// or a refund can be traced after the membership is gone.
  payerName       String?
  payerEmail      String?
  createdAt       DateTime  @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membership UserOrg?     @relation(fields: [userOrgId], references: [id], onDelete: SetNull)

  @@index([orgId, paidAt])
  @@map("dues_payments")
}

/// The recap for one month, drafted on the 1st and sent by an organiser.
///
/// **Frozen at generation**, the same bargain `ImpactReport` makes: `figures`
/// holds what was true when the month closed, and nothing recomputes it. A
/// recap that quietly read differently in March from the copy in a member's
/// inbox would make every number in it worthless.
///
/// Drafted rather than sent (Charley, 2026-10-01): a monthly letter to the
/// whole community carrying real money is worth one pair of human eyes, and
/// the organiser's own note is usually the part people actually read.
model MonthlyRecap {
  id            String             @id @default(uuid())
  orgId         String
  /// The first instant of the month being reported, in the co-op's timezone.
  periodStart   DateTime
  periodEnd     DateTime
  status        RecapStatus        @default(DRAFT)
  /// Every figure, frozen. Shaped by `recap-figures.ts`.
  figures       Json
  /// The organiser's own words, at the top of the email. Optional, and the
  /// recap sends without it.
  note          String?
  /// A paragraph composed from the frozen figures by the same service that
  /// writes impact reports, where the co-op has it configured.
  composed      String?
  composeStatus RecapComposeStatus @default(PENDING)
  composeNote   String?
  sentAt        DateTime?
  sentById      String?
  /// How many members it actually went to, recorded at send.
  sentCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, periodStart])
  @@map("monthly_recaps")
}

enum RecapStatus {
  DRAFT
  SENT
}

enum RecapComposeStatus {
  PENDING
  COMPOSING
  READY
  /// Composition is a nicety, never a blocker: a recap with no composed
  /// paragraph still has every figure and the organiser's note.
  SKIPPED
  FAILED
}
